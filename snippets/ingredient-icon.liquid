{% comment %}
  Renders one ingredient button icon by referencing a symbol from
  ingredient-icon-sprite.liquid (which must be rendered once in the same
  section, with the same uid, before this is called).

  Keyed on the spice's name rather than its position. The previous version
  matched on the block's loop index, which silently put the wrong drawing in
  every slot as soon as the block order differed from the order the artwork
  happened to sit in inside the source SVG - reordering spices in the theme
  editor was enough to scramble them. Matching on the name means the icon
  follows the spice around.

  Unrecognised name -> renders nothing, and the caller falls back to
  icon-or-image (the shared icon set / an uploaded image).

  Accepts:
    name       - the block's spice name, e.g. "Black pepper" (required)
    uid        - must match the uid the sprite was rendered with (use section.id)
    class_name - class for the <svg>

  The outer viewBox is a plain square: every symbol's own viewBox is square, so
  this just gives the <svg> a 1:1 intrinsic ratio for the CSS that sizes these
  with height:auto. The symbol's viewBox does the real framing.
{% endcomment %}

{%- liquid
  assign key = name | default: '' | handle
  assign symbol = ''

  case key
    when 'ginger'
      assign symbol = 'ginger'
    when 'cardamom', 'green-cardamom'
      assign symbol = 'cardamom'
    when 'cinnamon', 'cinnamon-stick', 'cinnamon-sticks'
      assign symbol = 'cinnamon'
    when 'cloves', 'clove'
      assign symbol = 'cloves'
    when 'black-pepper', 'pepper', 'peppercorn', 'peppercorns'
      assign symbol = 'pepper'
    when 'fennel', 'fennel-seeds', 'carom', 'carom-seeds', 'ajwain', 'carom-seeds-ajwain'
      assign symbol = 'carom'
    when 'star-anise', 'anise'
      assign symbol = 'star-anise'
    when 'coffee-bean', 'coffee-beans', 'coffee'
      assign symbol = 'coffee'
    when 'tea-leaf', 'tea-leaves', 'black-tea', 'tea'
      assign symbol = 'tea'
  endcase
-%}

{%- if symbol != blank -%}
  <svg
    class="{{ class_name }}"
    viewBox="0 0 100 100"
    aria-hidden="true"
    focusable="false"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
  ><use href="#kcc-ing-{{ uid }}-{{ symbol }}" xlink:href="#kcc-ing-{{ uid }}-{{ symbol }}" /></svg>
{%- endif -%}
