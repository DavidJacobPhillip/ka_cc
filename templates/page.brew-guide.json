        "dairy": {
          "type": "method",
          "settings": {
            "label": "With dairy",
            "note": "Makes one cup.",
            "steps": "<ol><li>Get two pots and a measuring cup. In one pot pour 2 ounces of water, and in the other pour 6 ounces of milk.</li><li>Mash up 2.5 grams of fresh ginger (optional) with a mortar and pestle if you have one — a blender works too — and add it to the water.</li><li>Put the water and ginger on the stove over a simmer. Wait for it to start bubbling, then add ½ tsp of the chai powder and stir regularly.</li><li>Let the chai spices boil for a few minutes, then add 1 teaspoon of black tea powder. Keep stirring on simmer-medium heat until the tea-water thickens significantly — the longer you brew, the stronger the flavor.</li><li>On the side, heat the pot of milk, stirring frequently, until it boils up — turn off the heat before it boils over.</li><li>Dump the chai water into the milk, and let the final mixture boil up one more time over medium heat.</li><li>Strain, and ready to serve!</li></ol>"
          }
        },
