    "value_props": {
      "type": "value-props",
      "blocks": {
        "p1": {
          "type": "prop",
          "settings": {
            "title": "Whole spices, ground fresh",
            "body": "Nothing pre-ground, nothing sitting in a warehouse losing its oils. We mill in small batches so the cardamom still smells like cardamom."
          }
        },
        "p2": {
          "type": "prop",
          "settings": {
            "title": "Two leaves, two origins",
            "body": "Assam for malty depth, Kericho for backbone. One tea alone gives you one note; blended, they hold their own against milk and spice."
          }
        },
        "p3": {
          "type": "prop",
          "settings": {
            "title": "Built for a real cup",
            "body": "Brewed the way it's made at home — on the stove, with milk, no syrups. If it disappears under a splash of oat milk, we haven't done our job."
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3"
      ],
      "settings": {
        "heading": "Why people keep coming back",
        "color_scheme": "scheme-2",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "founder_note": {
      "type": "founder-note",
      "blocks": {},
      "block_order": [],
      "settings": {
        "eyebrow": "A note from us",
        "heading": "We just wanted chai that tasted like home",
        "body": "<p>[Draft — rewrite in your own voice, this is a stand-in] It started because nothing we could buy tasted like the chai we grew up on. Everything was either syrupy and sweet or so faint you lost it the moment it hit milk.</p><p>So we started making it ourselves — whole spices, ground in small batches, a tea blend picked to stand up rather than disappear. We brought it to a farmers market to see if anyone else felt the same way. They did.</p>",
        "signature": "— [Draft: founder name]",
        "caption": "Mid-pour at Cedar Mills, where most of this started",
        "link_label": "Read our story",
        "link_url": "/pages/our-story",
        "color_scheme": "scheme-2",
        "section_width": "page-width",
        "padding-block-start": 72,
        "padding-block-end": 72,
        "photo": "kcc-making-chai-stall.jpg",
        "photo_size": "1199x1800",
        "photo_alt": "Pouring freshly made chai into a cup behind the market stall"
      }
    },
