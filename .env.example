# Copy to .env and fill in. .env is gitignored - never commit real credentials.
SHOPIFY_STORE=50b7p1-da.myshopify.com

# Preferred: Dev Dashboard app (dev.shopify.com).
# Admin-created custom apps were retired on 2026-01-01, so new apps get a
# client id/secret instead of a permanent token. The script exchanges these for
# a 24h token on each run, so nothing long-lived is stored on disk.
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy alternative, only if you already have an older custom app:
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
# SHOPIFY_API_VERSION=2026-07
