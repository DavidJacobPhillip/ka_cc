<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>

    <link rel="preload"
      href="{{ 'NotoCondensed.woff' | asset_url }}"
      as="font"
      type="font/woff"
      crossorigin>

    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    <style>
      @font-face {
        font-family: 'Noto Serif Display Extra Condensed';
        src: url('{{ 'NotoCondensed.woff' | asset_url }}') format('woff');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      /* Applied directly instead of through settings.type_heading_font -
         that font-picker setting needs a real custom-font upload through
         the theme editor's Typography panel to resolve correctly, and
         the file it was pointing at (uploaded to Shopify Files some other
         way) never registered as a picker entry. This uses the same font
         file already sitting in assets/, so it works with zero admin
         steps. Also sets --font-heading--family so every element that
         reads that variable (nav, marquee, gallery label, not just literal
         h1-h6 tags) picks it up consistently. */
      :root {
        --font-heading--family: 'Noto Serif Display Extra Condensed', serif;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Noto Serif Display Extra Condensed', serif;
      }
    </style>
  {% include 'pagefly-app-header' %}</head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    <style>
      /* No header logo anywhere on the site; the header is nav-text only. */
      #header-component .header-logo {
        display: none !important;
      }

      /* Force white nav text while the header is transparent (unscrolled/top
         of page), matching the same condition the theme itself uses to decide
         when the header is in its see-through state. Reverts naturally once
         the header goes solid/sticky, where the default dark text applies. */
      :is(
        #header-component[transparent]:not([data-sticky-state='active']),
        #header-component[transparent='always'][data-sticky-state='active']
      )
        .menu-list__link {
        --color-foreground: rgb(255, 255, 255);
        --color-foreground-rgb: 255, 255, 255;
        color: #ffffff;
      }

      /* Announcement bar: white background (scheme-1) with brown text.
         scheme-1's default foreground is near-black, so the text color
         needs a direct override to the brand terracotta. */
      .announcement-bar {
        color: #cd643f;
      }

      /* background-color is no longer transitioned by CSS - it's set as
         an inline style directly from scroll position in
         nav-scroll-color.js (index-only), so it moves in lockstep with
         the scrollbar instead of animating on a fixed timer once the
         theme's data-sticky-state flips. #header-component's id still
         beats the theme's own transition rules for color/border-color. */
      #header-component .header__row {
        transition: color 0.4s ease-in-out, border-color 0.4s ease-in-out;
      }

      /* The white strip below the nav, confirmed via debug outlines: the
         header always renders a second "bottom" row alongside the visible
         top row - snippets/header-row.liquid builds it because search is
         assigned search_row: "bottom" in the schema default, so a
         (visually empty, since show_search is false) right-hand column
         div still gets emitted for it. That's non-blank HTML, so
         header.liquid's blank-check (line ~231) still renders the row's
         wrapper. Its color_scheme_bottom setting is unset, so once the
         header goes solid/sticky it paints with the inherited page
         background (white) directly under the brown top row, instead of
         being invisible like the top row is while transparent. We don't
         use a bottom row at all (no search, no secondary nav), so it's
         safe to remove entirely rather than trying to color-match it. */
      #header-component .header__row--bottom {
        display: none !important;
      }

      /* The theme dims every non-current-page nav link (opacity) whenever
         one link is marked active/current, so only the current page's
         link stays full color. Not wanted here - all four top-level nav
         items should stay the same white regardless of which page is
         current. #header-component gives this enough specificity to beat
         the theme's own dimming rule, which has no id selector. */
      #header-component .menu-list__link {
        color: var(--menu-top-level-font-color);
      }

      /* More breathing room between top nav items - default is
         --gap-xl (1.25rem/20px), which reads as cramped now that the
         nav is set at 3.5rem. */
      #header-component .menu-list {
        --menu-horizontal-gap: 2.25rem;
      }

      /* Above the mobile hamburger cutoff (750px), the four nav items at
         full desktop size don't have room to sit inline until the
         viewport is wide enough, so the theme's own <overflow-list>
         (assets/critical.js) moves the ones that don't fit into a
         "More" dropdown - it measures actual rendered widths, it isn't
         tied to a breakpoint.

         The real var as ceiling (see below) makes this mathematically
         guaranteed to match the theme's actual desktop size once the
         viewport is wide enough, with no seam anywhere since it's one
         continuous formula for every width from 750px up - confirmed
         correct at desktop widths. The floor/coefficient below were
         tuned to shrink noticeably at 750px, which read as too small
         given only the ~750-900px band actually risks "More" - raised
         both so it now only tapers subtly right at 750px and is
         visually indistinguishable from full desktop size almost
         immediately above that, rather than looking reduced across the
         whole tablet range. */
      @media screen and (min-width: 750px) {
        #header-component .menu-list__link {
          font-size: clamp(1.05rem, 3vw, var(--menu-top-level-font-size-desktop));
        }

        #header-component .menu-list {
          --menu-horizontal-gap: clamp(1.1rem, 4vw, 2.25rem);
        }
      }

      /* Cart/account icons much larger than the theme's default ~20px
         icon set, and matched to the same height so they read as the
         same size - height-only, width auto for both, since forcing
         either into a fixed square distorts/shrinks it (their artwork
         isn't perfectly square: cart is 410x457, account is 443x456).
         Covers .svg-wrapper's own box (cart) and both icons' inner svg
         (base.css otherwise forces .svg-wrapper and its svg to the
         same fixed size variable; .account-button__icon has no default
         size of its own). clamp() instead of a fixed rem value so it
         scales with viewport width instead of staying one fixed size
         at every screen size. */
      #header-component .svg-wrapper,
      #header-component .svg-wrapper > svg,
      #header-component .account-button__icon svg {
        width: auto;
        height: clamp(1.6rem, 3.6vw, 2.5rem);
      }

      /* Slight grow-on-hover, desktop only (hover:hover media guard,
         same pattern the theme itself uses to skip this on touch
         devices where there's no real hover state to trigger it).
         transform: scale() instead of changing height/width - resizing
         the box directly reflowed the flex row (header-actions), which
         shifted the OTHER icon sideways whenever one was hovered. A
         transform is paint-only and never affects layout, so hovering
         one icon can no longer move its sibling.

         Applied to .header-actions__action (the shared class on both
         the cart <a> and the account <button>) rather than each icon's
         own inner element - debug outlines showed cart's icon (nested
         two levels deeper, inside a position:relative <cart-icon>)
         rendered BEHIND header-actions on hover while account's (one
         level shallower, transform directly on its <svg>) rendered in
         front. Likely a stacking-context quirk from transform being
         applied at different DOM depths relative to cart-icon's own
         positioned context. Transforming the same outer element for
         both sidesteps the asymmetry entirely instead of chasing the
         exact stacking mechanics. transform-origin: center grows
         evenly in all directions (2.75rem to 3rem is a ~1.091x scale
         on the icon, so scaling the outer element by the same factor
         matches it). */
      #header-component .header-actions__action {
        transform-origin: center;
        transition: transform var(--animation-speed) var(--animation-easing);
      }

      @media (hover: hover) {
        #header-component .header-actions__action:hover {
          transform: scale(1.091);
        }
      }

      /* .account-button (the actual <button>, not just the icon span)
         is hardcoded to a fixed 44x44px box (--button-size, the
         accessible min tap target) - base.css's global svg { max-width:
         100% } reset then caps the icon's width to that 44px box, which
         drags its height down too (to preserve aspect ratio), so it
         rendered smaller than the height set above despite that value
         being correct. Cart's wrapper has no fixed size so it wasn't
         affected. Auto-sizing the button removes that cap; it still
         ends up bigger than the 44px minimum since the icon itself is
         now taller than that, so accessible tap-target size is kept. */
      #header-component .account-button {
        width: auto;
        height: auto;
      }

      /* The theme dims every other interactive element in the same
         header column whenever one is hovered (sections/header.liquid,
         the ".header__column:has(...:hover) ... :not(:hover) { opacity:
         var(--opacity-subdued-text) }" rule) - meant for a column with
         several different controls (menu, search, localization), but
         with just cart and account sharing a column it means hovering
         one greys out the other. #header-component's id beats that
         rule's specificity, so hovering either one now leaves both at
         full opacity. */
      #header-component .header-actions__action {
        opacity: 1;
      }

      /* A bit more breathing room between the cart and account icons -
         header-actions (their shared flex container) has no gap by
         default. Bottom-aligned rather than the flex default (stretch/
         top) because cart and account render at different heights
         (square vs taller artwork with "profile" underneath) - bottom-
         aligning makes both icons' actual pictograms sit level, since
         it's the account icon's extra lettering that adds the height
         difference below. */
      #header-component header-actions {
        gap: 1rem;
        align-items: flex-end;
      }

      /* On mobile, sections/header.liquid's grid squeezes header-actions
         (holding BOTH cart and account together) into a single 44px
         "bookend" column (--header-mobile-bookend) out of a five-column
         leftA/leftB/center/rightA/rightB layout - two ~40-44px icons plus
         a gap don't fit in 44px total, which is why they were rendering
         inconsistently sized/cramped. show_search is false in this
         theme, so the adjacent rightA column (normally the search
         icon's) is unclaimed - letting header-actions span rightA
         through rightB gives it roughly double the room instead of
         shrinking the icons down to fit one slot. Revisit this if search
         ever gets enabled, since it would then also want rightA. */
      @media screen and (max-width: 749px) {
        #header-component header-actions {
          grid-column: rightA-start / rightB-end;
          justify-content: flex-end;
          /* The 1rem gap (set above, shared with desktop) reads as too
             much space next to mobile's smaller clamp()-scaled icons -
             tightened just for this breakpoint. */
          gap: 0.375rem;
          /* Extra room between the cart icon and the screen's right
             edge - .header__columns' own mobile inline-end padding
             (--padding-3xs) is quite small, so add more here rather
             than touching that shared theme variable. */
          padding-inline-end: 1rem;
        }
      }

      /* Nav logo badge (injected by nav-scroll-color.js, opacity driven
         from there). Desktop: absolute on the left edge at var(--page-
         margin), matching the header's own real content inset. Mobile:
         dropped into the grid's "center" area instead - the same slot
         sections/header.liquid gives the theme's own .header-logo, which
         is hidden sitewide (see the display:none rule near the top of
         this style block) and so leaves that slot empty. align-items:
         center on .header__columns at that breakpoint already centers
         it vertically, so no absolute/transform positioning is needed
         there. */
      #header-component .nav-logo-badge {
        position: absolute;
        left: var(--page-margin);
        top: 50%;
        transform: translateY(-50%);
        height: clamp(2.5rem, 5vw, 4rem);
        width: auto;
        opacity: 0;
        pointer-events: none;
      }

      @media screen and (max-width: 749px) {
        #header-component .nav-logo-badge {
          position: static;
          grid-area: center;
          justify-self: center;
          transform: none;
          height: clamp(2.75rem, 11vw, 3.5rem);
        }

        /* The row's own height is content-driven (no fixed height set
           anywhere), so it already grows to fit the taller logo above -
           this just gives it a bit more breathing room top/bottom to
           match, rather than the logo nearly touching the row's edges. */
        #header-component .header__row--top .header__columns {
          --header-padding: var(--padding-md);
        }
      }
    </style>
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {% if template == 'index' %}
        <style>
          #MainContent {
            position: relative;
          }

          /* The theme adds --section-top-offset (equal to the header's
             height) as top padding on the first section in <main>, meant
             to keep a transparent header from covering that section's
             content (sections/header.liquid). But .hero__media-wrapper is
             absolutely positioned *inside* .hero__container, so that
             padding also pushes the background video/image's starting
             point down, leaving a gap at the top where no media renders -
             just the plain page background showing through. Other
             sections in this theme (media-with-content, slideshow) opt
             out via a disable-section-top-offset class; the hero section
             doesn't, so override the variable directly instead of editing
             the core hero.liquid file. !important because the theme's own
             selector (main > .shopify-section:first-child .section:not(...))
             is more specific than an attribute-scoped selector alone. */
          [id^="Hero-"] .hero__container {
            --section-top-offset: 0px !important;
          }

          /* Using [id^="Hero-"] instead of a literal #Hero-hero_main id -
             Shopify renders JSON-template sections as
             Hero-template--<numeric-id>__hero_main, not the bare section
             key, so an exact-id selector never matches. */
          /* Override the grid's own track variables at their source
             (.hero__container is the .section element that defines them)
             instead of trying to cancel the rendered margin from a nested
             descendant - a prior attempt used --util-page-margin-offset
             inside a calc() on .hero__content-wrapper, but that variable's
             formula contains a "100%" that only resolves correctly
             relative to the element that consumes it, and
             .hero__content-wrapper is a narrower, already-centered child,
             not the full section width.

             Both --full-page-grid-margin AND
             --full-page-grid-central-column-width must be overridden
             together so the three grid tracks (margin, content, margin)
             still sum to exactly 100%. Setting only the margin variable
             (dropping its original 1fr) left the tracks summing to less
             than 100%, and CSS Grid doesn't stretch to fill leftover
             space by default - it left it empty on the right instead. */
          [id^="Hero-"] .hero__container {
            --full-page-grid-margin: 4vw;
            --full-page-grid-central-column-width: calc(100% - 8vw);
          }

          /* The h1's own line-height leading dwarfs the flex gap between the
             logo and heading, so control the visual spacing directly here
             instead of relying on the flex gap. */
          [id^="Hero-"] .text-block.h1 {
            margin-block-start: 16px;
            will-change: transform;
          }

          /* Keep "Welcome to the world of" on one line on mobile instead
             of wrapping, and fill the available width instead of
             reading small next to the logo above it. Several vw-based
             guesses at the right font-size all landed wrong - assuming
             particular glyph-width metrics for this font isn't
             reliable. assets/hero-heading-fit.js measures the real
             rendered text width against the real available width on
             load and sets an exact font-size from that ratio instead of
             guessing; the clamp() below is only its pre-JS fallback. */
          @media screen and (max-width: 749px) {
            /* The block's own "narrow" max-width setting caps it at
               35ch (snippets/theme-styles-variables.liquid), computed
               against whatever font-size is active where --max-width is
               consumed - not necessarily this element's own overridden
               size - so it was silently capping the box well short of
               the font-size above, leaving empty space on the right
               even though the text itself was sized to fill it. This
               heading is a viewport-spanning display line, not body
               copy, so the reading-width cap doesn't apply here anyway. */
            [id^="Hero-"] .text-block.h1 {
              max-width: none;
            }

            [id^="Hero-"] .text-block.h1 > * {
              font-size: clamp(1.75rem, 8.5vw, 3rem);
              white-space: nowrap;
            }

            /* Larger still - the previous bump (120px/20vw base clamp
               to 140px/24vw) still read as small next to the now-larger
               heading beneath it. */
            [id^="Hero-"] .hero-logo-lockup__image {
              height: clamp(170px, 30vw, 320px);
            }
          }

          #ka-rail {
            position: absolute;
            /* Left: var(--page-margin) (40px) read as too much gap from
               the true edge - a smaller fixed value instead, still
               detached from the edge but noticeably tighter.

               Top: previously a fixed 2rem from #MainContent's own top
               (= the hero's top) - but the hero itself is much taller
               than that (viewport-height-based), so that gap was
               entirely swallowed inside the hero's own height and never
               produced any actual separation from the hero's real
               (rendered) bottom edge - the rail's colored area was
               already "running" underneath the hero the whole time, so
               it picked up again immediately once the hero ended, with
               no visible gap at all. Now anchored to --hero-height
               (assets/ka-rail-position.js measures the real rendered
               hero height, same measure-don't-guess approach as
               hero-heading-fit.js) plus a real gap on top of that,
               so it's guaranteed to start after the hero however tall
               it actually renders. 100vh fallback covers the brief
               window before that script runs.

               inset-block-end stays 0 so it still reaches the bottom of
               the page. No longer hidden below 750px - see the
               #MainContent > div.shopify-section padding-inline-start
               rule below for how content stays clear of it now that
               it's visible there. */
            inset-block-start: calc(var(--hero-height, 100vh) + 1.5rem);
            inset-block-end: 0;
            inset-inline-start: 0.75rem;
            width: 40px;
            z-index: -1;
            background: #cd643f;
            overflow: hidden;
            pointer-events: none;
          }

          /* Desktop-only: ever so slightly further right than the base
             0.75rem mobile value above - kept as a separate, smaller bump
             rather than raising the base value, since mobile needs to
             stay close to that tighter number for the "push everything
             else right" effect below to read as intentional rather than
             excessive. */
          @media screen and (min-width: 750px) {
            #ka-rail {
              inset-inline-start: 1.25rem;
            }
          }

          /* Replaces the previous repeated "ka" text - a column of small
             icons running down the center of the rail instead. Centered
             horizontally (align-items: center) within the rail's 40px
             width; the parent's overflow:hidden (see #ka-rail above)
             clips whatever the repeat count below doesn't fill or
             overruns, same safety-clamp role the old span's sheer
             repeat-300-times count played for text. */
          #ka-rail .ka-rail__icons {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            padding-block-start: 24px;
            /* Perpetual downward scroll. Loop distance is exactly one
               icon+gap unit (14px icon + 20px gap = 34px) rather than
               the whole (very tall) column - since every icon is
               identical and evenly spaced, shifting by one unit and
               resetting lands on a frame pixel-identical to the start,
               so the loop reads as continuous instead of visibly
               jumping. Doesn't need the strip duplicated the way a
               marquee normally would for a seamless loop. */
            animation: ka-rail-scroll 3s linear infinite;
          }

          @keyframes ka-rail-scroll {
            from {
              transform: translateY(-34px);
            }

            to {
              transform: translateY(0);
            }
          }

          @media (prefers-reduced-motion: reduce) {
            #ka-rail .ka-rail__icons {
              animation: none;
            }
          }

          #ka-rail .ka-rail__icon {
            width: 14px;
            height: 14px;
            color: #ffffff;
            flex-shrink: 0;
          }

          /* Push every homepage section below the hero right, clear of
             the rail, rather than patching one section at a time -
             #MainContent > div.shopify-section matches every section
             except the hero (sections/hero.liquid is the only one on
             this page with a custom "tag": "section" in its schema;
             every other section here renders as the default div, so this
             selector naturally excludes it without needing to name it).
             2.5rem stacks on top of each section's own existing
             var(--page-margin) rather than replacing it, so combined
             clearance from the true edge is ~2.5rem + page-margin: ~56px
             on mobile (comfortably past the rail's ~52px footprint
             there: inset-inline-start 0.75rem + 40px width) and ~80px at
             desktop (well past its ~60px footprint there). Generous
             rather than tightly tuned to each breakpoint's exact number,
             since it's cheap insurance against the same overlap the
             intro heading hit turning up in a section further down the
             page that hasn't been individually checked.

             2.5rem left only ~4px of actual visible gap between the
             rail's right edge and the heading on mobile (confirmed via
             screenshot) - bumped to 3rem for a bit more breathing room. */
          #MainContent > div.shopify-section {
            padding-inline-start: 3rem;
          }

          /* "Connections" section (templates/index.json's "intro" key,
             right under the hero) - [id$="__intro"] matches Shopify's
             own auto-generated shopify-section-{{ section.id }} wrapper
             id, which ends in the section's JSON key since this section
             (sections/section.liquid) doesn't set a custom id prefix
             the way hero.liquid does with "Hero-". */

          /* Heading links ("connections", "chai"): the theme's global
             a{} rule (assets/base.css) sets text-decoration-color:
             transparent by default, and the rule that restores a
             visible underline only targets links inside p/.rte
             contexts (assets/base.css ~line 909) - these links sit
             directly inside a bare <h2>, so neither that underline nor
             any bold weight was ever applying. Color is set explicitly
             to the brand terracotta (same hex used in nav-scroll-
             color.js) rather than trusting --color-foreground to
             already resolve to it. */
          /* Same "narrow" max-width bug as the hero heading
             (templates/index.json's heading_col has max_width:"narrow",
             a 35ch reading-width cap computed against a different
             font-size context than this block's own) - removing it
             here too, now that the 1.7x-larger text below makes the
             mismatch between the cap and the actual rendered width
             wide enough to force an extra wrapped line. */
          [id$="__intro"] .text-block.h2 {
            max-width: none;
          }

          /* Stacking is now handled entirely by the theme's own native
             750px cutoff (.mobile-column below that, row layout above) -
             no override needed here anymore. Per Santosh's direction, the
             row layout stays live all the way down to 750px instead of
             switching to stacked early; the heading's font-size (below)
             shrinks further to compensate for how much tighter that is
             than the previous 900px line. */


          [id$="__intro"] .text-block.h2 > * {
            color: #cd643f;
            line-height: 1.35;
            /* Below 750px, where .mobile-column stacks the columns and
               the heading gets the full row width - but "full row width"
               on a narrow phone, minus the ~2.5rem section clearance
               added above to stay clear of the rail, is a lot less room
               than it sounds. This used to be a flat 1.4x here, which
               was fine when the rail was desktop-only and mobile kept
               its whole width - once the rail (and this section's
               clearance padding for it) started applying on mobile too,
               that flat size no longer reliably fit at real phone
               widths, and with white-space: nowrap below and no
               overflow:hidden ancestor, the overflow was spilling
               straight past the viewport's right edge (visible as
               unexplained blank space when scrolled). Fluid instead,
               ramping 0.935x at 320px up to 1.045x - matching the
               row-layout rule's own starting value so there's no jump at
               the 750px seam - but reaching that ceiling by 480px rather
               than stretching the ramp out across the full 320-750
               range. Nearly every real phone falls within 320-430px, so
               a ramp sized to the full range barely moved within that
               span (roughly 0.935x to 0.96x - visually indistinguishable
               "tiny" at every real phone width, confirmed by Santosh not
               reading as responsive at all) - the actual visual growth
               was almost entirely happening in the 430-750px zone real
               phones never occupy. Steeper range means real phones cover
               the whole 0.935x-1.045x span; 480-750px (phablet-ish
               widths) just holds flat at the ceiling instead of
               continuing to grow, which was never the part that needed
               fixing. */
            font-size: calc(
              var(--font-h2--size) *
              clamp(0.935, calc(0.935 + ((100vw - 320px) / 160px) * 0.11), 1.045)
            );
            /* Hard guarantee against wrapping within either line (the
               explicit <br> between "connections" and "over ___" still
               breaks regardless of this - <br> isn't suppressed by
               white-space). Unlike the hero heading, this section has no
               overflow:hidden ancestor, so if a particularly long cycling
               word (e.g. "delicious food") ever did overrun at some
               extreme width, it would spill visibly rather than clip
               invisibly. */
            white-space: nowrap;
          }

          /* Row layout (>=750px): the heading only gets roughly half the
             section width once the caption column (capped below) takes
             its share, so a flat font-size that looks right at wide
             desktop widths is too big right at 750px - noticeably
             tighter than the previous 900px line this was tuned against,
             so the floor comes down accordingly (1.045x here, matching
             the base rule's own new ceiling above) rather than the full
             1.54x. Scales the h2's own multiplier fluidly instead of
             guessing one fixed value, ramping up to the full 1.54x by
             1300px and flat above that. Built as a ratio ((100vw -
             750px) / 550px is unitless - dividing a length by a length)
             rather than vw-ing an absolute rem/px value directly, so it
             scales relative to --font-h2--size the same way the base
             rule above does instead of a standalone guess. (Both ends
             bumped 10% per Santosh's direction - was 0.95x-1.4x.) */
          @media screen and (min-width: 750px) {
            [id$="__intro"] .text-block.h2 > * {
              font-size: calc(
                var(--font-h2--size) *
                clamp(1.045, calc(1.045 + ((100vw - 750px) / 550px) * 0.495), 1.54)
              );
            }
          }

          [id$="__intro"] .text-block.h2 a {
            /* base.css's global a{} rule sets its own explicit color
               (var(--button-color)), which overrides inheritance from
               the h2 above regardless of that rule's higher
               specificity - a direct rule on the element itself always
               beats an inherited value. That's why these were still
               rendering in whatever --button-color resolves to (black)
               instead of the terracotta set above. */
            color: inherit;
            font-weight: 700;
            text-decoration: underline;
            text-decoration-color: currentcolor;
            text-decoration-thickness: 0.08em;
            text-underline-offset: 0.15em;
          }

          /* Typewriter cursor for the cycling words (assets/intro-word-
             cycle.js types/deletes into .cycle-word__text; this is the
             blinking bar next to it). text-decoration:none keeps the
             link's underline (set above) from running under it. */
          [id$="__intro"] .cycle-word__cursor {
            display: inline-block;
            margin-inline-start: 0.03em;
            text-decoration: none;
            animation: cycle-word-blink 1s step-end infinite;
          }

          @keyframes cycle-word-blink {
            0%,
            100% {
              opacity: 1;
            }

            50% {
              opacity: 0;
            }
          }

          @media (prefers-reduced-motion: reduce) {
            [id$="__intro"] .cycle-word__cursor {
              animation: none;
            }
          }

          /* Blurb column: was one <p> with <br> tags, which don't get
             paragraph margin - split into separate <p> elements above
             (templates/index.json) and given an explicit gap here
             instead of relying on the theme's own (unverified) default
             paragraph spacing. */
          [id$="__intro"] .text-block.rte > p + p {
            margin-block-start: 1em;
          }

          /* Slightly larger than the paragraph default, scaled relative
             to --font-paragraph--size via calc() for the same reason as
             the heading above. Color: the "warm dark brown" from
             PROJECT_CONTEXT.md's reviews-section note (#2b1608) rather
             than the near-black this was rendering as - the text
             setting's own "color" value is deliberately skipped for rte
             presets (snippets/typography-style.liquid), so it was
             always just falling through to --color-foreground, never
             actually customized. Set on the wrapper and explicitly on
             p/strong too, since this session has repeatedly hit cases
             where a more specific rule elsewhere set color directly on
             the inner element and silently beat inheritance.

             #2b1608 (confirmed deployed and applying) still looked
             indistinguishable from plain black on screen - scheme-1's
             default foreground is #1a1a1a, and the two colors have
             nearly identical luminance (~10% vs ~10.5%), differing only
             in hue. #2b1608 was borrowed from a note about the dark
             *reviews section background*, a value picked to work as a
             near-black bg, not to read as visibly brown as body text on
             white. Swapped for #754B2A, same warm-brown family but
             enough lighter/more saturated to actually register as brown
             rather than black at body-copy size - now the "Warm Brown"
             entry in PROJECT_CONTEXT.md's palette table (§4). */
          [id$="__intro"] .text-block.rte,
          [id$="__intro"] .text-block.rte p,
          [id$="__intro"] .text-block.rte strong {
            color: #754B2A;
          }

          [id$="__intro"] .text-block.rte {
            font-size: calc(var(--font-paragraph--size) * 1.15);
          }

          /* margin-inline-start and max-width below are specifically for
             the side-by-side row layout (>=750px, matching the theme's
             own native cutoff) - they shift the caption right and cap
             its width so the heading column has room. Scoped to that
             range only: unscoped, they'd also indent and narrow the
             caption below 750px, where .mobile-column stacks it and it
             should sit flush and full-width under the heading instead
             like a normal single column. */
          @media screen and (min-width: 750px) {
            [id$="__intro"] .text-block.rte {
              margin-inline-start: 3rem;
              /* The caption column was measured at 425px wide (of a
                 958px viewport) via DevTools, squeezing the heading
                 column down to ~400px - explicit cap frees up real room
                 for the heading instead of just nudging this column's
                 position within whatever width it was already claiming. */
              max-width: 20rem;
            }
          }

          /* Gap between the heading and caption columns (row layout) /
             between the stacked elements (below 750px) - the section's
             own gap setting (templates/index.json's "gap": 40) renders
             as an inline --gap: max(24px, calc(var(--gap-scale, 1.0) *
             40px)) on the same element --flex-direction lives on, so
             this needs !important for the same reason that one does -
             a plain <style> rule can't beat an inline declaration.
             Tightened per Santosh's direction, both to read less spaced
             out and to free up a bit more room for the heading in the
             row layout. */
          [id$="__intro"] .layout-panel-flex {
            --gap: 1.5rem !important;
          }
        </style>
        <div id="ka-rail" aria-hidden="true">
          <div class="ka-rail__icons">
            {%- for i in (1..250) -%}
              {%- render 'ka-rail-icon' -%}
            {%- endfor -%}
          </div>
        </div>
        <script defer src="{{ 'hero-heading-scroll.js' | asset_url }}"></script>
        <script defer src="{{ 'hero-heading-fit.js' | asset_url }}"></script>
        <script defer src="{{ 'hero-logo-scroll.js' | asset_url }}"></script>
        <script defer src="{{ 'ka-rail-position.js' | asset_url }}"></script>
        <script>window.KCC_NAV_LOGO_SRC = {{ 'logo-white.png' | asset_url | json }};</script>
        <script defer src="{{ 'nav-scroll-color.js' | asset_url }}"></script>
        <script defer src="{{ 'intro-word-cycle.js' | asset_url }}"></script>
      {% endif %}

      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
