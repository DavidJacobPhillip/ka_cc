{% comment %}
  "Why Ka" - a short row of reasons to buy, sitting between the intro and the
  shop teaser. Both Kolkata Chai Co and Elaichi Co run a block like this high on
  the page (they call it wellness benefits / "why you'll love us"); it's the
  thing that turns a nice-looking brand page into a reason to order.

  Each prop is a block so they can be reordered, added to or removed in the
  theme editor. Kept to three across on desktop - four starts to read as a
  feature matrix rather than a point of view.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} value-props spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="value-props__heading h2">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <ul class="value-props__list" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'prop' -%}
        <li class="value-props__item" {{ block.shopify_attributes }}>
          <span class="value-props__index" aria-hidden="true">
            {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="value-props__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="value-props__body">{{ block.settings.body }}</p>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .value-props__heading {
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .value-props__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .value-props__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .value-props__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  /* A thin numeral rather than an icon: the page already carries a lot of
     line-art in the ingredient row just below, and a second icon set competing
     with it made the whole page read as busy. */
  .value-props__index {
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    color: var(--color-primary, currentColor);
    padding-block-end: 0.5rem;
    border-block-end: 1px solid var(--color-primary, currentColor);
    min-width: 2.25rem;
  }

  .value-props__title {
    font-family: var(--font-heading--family);
    font-size: 1.375rem;
    line-height: 1.25;
    margin: 0.4rem 0 0;
    text-wrap: balance;
  }

  .value-props__body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    opacity: 0.78;
    max-width: 34ch;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value props",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why people keep coming back" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "title": "Whole spices, ground fresh",
            "body": "Nothing pre-ground, nothing sitting in a warehouse losing its oils. We mill in small batches so the cardamom still smells like cardamom."
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "Two leaves, two origins",
            "body": "Assam for malty depth, Kericho for backbone. One tea alone gives you one note; blended, they hold their own against milk and spice."
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "Built for a real cup",
            "body": "Brewed the way it's made at home - on the stove, with milk, no syrups. If it disappears under a splash of oat milk, we haven't done our job."
          }
        }
      ]
    }
  ]
}
{% endschema %}
