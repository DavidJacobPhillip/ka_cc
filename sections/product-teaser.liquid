{% comment %}
  The two product cards that sit just under the hero.

  Styled after the packaging-card artwork: an outlined card in the brand
  terracotta, the product name across the top in the heading serif, the photo
  inset below it, and a solid call-to-action bar flush to the bottom edge.

  Two things worth knowing before editing:

  1. The image ratio is a real setting and defaults to 4:3, which is the chai
     photo's native ratio and only trims the sides of the coffee one. Leaving
     it on a shared ratio is what keeps both cards' bars on one baseline.
  2. The bar is a link by default, because the store has no products yet and a
     bar reading "add to cart" that adds nothing is a lie. Pick a product in
     the block and it becomes a real add-to-cart form instead - no other
     change needed.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} product-teaser spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="product-teaser__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-teaser__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="product-teaser__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    case section.settings.image_ratio
      when 'square'
        assign ratio = '1'
      when 'three-two'
        assign ratio = '3 / 2'
      when 'four-three'
        assign ratio = '4 / 3'
    endcase
  -%}

  <ul
    class="product-teaser__grid"
    role="list"
    style="--pt-max: {{ section.settings.max_width }}rem;"
  >
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        <li class="product-teaser__card" {{ block.shopify_attributes }}>
          <div class="product-teaser__inner">
            {%- if block.settings.title != blank -%}
              <h3 class="product-teaser__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              {%- comment -%}
                `adapt` leaves --pt-ratio unset so the image keeps its own shape.
                Every other option pins both cards to the same ratio so their
                captions sit on a shared baseline.
              {%- endcomment -%}
              <div
                class="product-teaser__media"
                {% if ratio %}style="--pt-ratio: {{ ratio }};"{% endif %}
              >
                <img
                  class="product-teaser__image"
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  srcset="{{ block.settings.image | image_url: width: 440 }} 440w, {{ block.settings.image | image_url: width: 660 }} 660w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 750px) 26rem, 90vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              {%- comment -%}
                Escaped because these are plain-text settings, and the coffee
                copy contains a bare ampersand.
              {%- endcomment -%}
              <p class="product-teaser__line">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>

          {%- if block.settings.link_label != blank -%}
            {%- assign card_product = block.settings.product -%}
            {%- if card_product != blank and card_product.available -%}
              {%- comment -%}
                A plain POST to /cart/add, so the bar works without JavaScript.
                It lands on the cart page rather than opening the drawer.
              {%- endcomment -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-teaser__cta-form">
                <input type="hidden" name="form_type" value="product">
                <input type="hidden" name="utf8" value="✓">
                <input
                  type="hidden"
                  name="id"
                  value="{{ card_product.selected_or_first_available_variant.id }}"
                >
                <button
                  type="submit"
                  class="product-teaser__cta product-teaser__cta--{{ section.settings.cta_style }}"
                >
                  {{- block.settings.link_label -}}
                </button>
              </form>
            {%- else -%}
              <a
                class="product-teaser__cta product-teaser__cta--{{ section.settings.cta_style }}"
                href="{{ block.settings.link_url | default: '/collections/all' }}"
              >
                {{- block.settings.link_label -}}
              </a>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .product-teaser {
    /* The card frame, the title and the bar are all one terracotta. Pulled
       from the scheme so a scheme swap carries the whole card with it. */
    --pt-accent: var(--color-primary, #cd643f);
    --pt-accent-deep: var(--color-primary-hover, #a45032);
    --pt-ink: #754B2A;
    --pt-radius: 1.5rem;
  }

  .product-teaser__head {
    text-align: center;
    margin-block-end: 2.5rem;
  }

  .product-teaser__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--pt-accent);
  }

  .product-teaser__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
    margin: 0;
    text-wrap: balance;
  }

  /* Capped and centred rather than filling the page. At full width each card
     was over 40% of a laptop viewport, which read as two billboards instead of
     a pair of products. */
  .product-teaser__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    /* Explicit, because `.section` sizes its children by content and the
       cards are inline-size containers - their max-content contribution is
       zero, so the row would shrink to the bare 16rem track minimums. */
    width: 100%;
    max-width: var(--pt-max, 54rem);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .product-teaser__grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    }
  }

  /* Outlined rather than shadowed at rest: the frame is the look. `overflow`
     is what crops the bar into the two bottom corners. */
  .product-teaser__card {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--pt-accent);
    border-radius: var(--pt-radius);
    overflow: hidden;
    /* White rather than var(--color-background): the section sits on the cream
       scheme, so the variable would resolve to the same cream and the card
       would disappear against it. */
    background: #fff;
    /* So the title can be sized off the card rather than the viewport. */
    container-type: inline-size;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .product-teaser__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0.75rem 1.75rem rgb(43 22 8 / 0.12);
  }

  /* `flex: 1` so a one-line description doesn't leave that card's bar riding
     higher than its neighbour's. */
  .product-teaser__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 1.25rem;
    padding: clamp(0.875rem, 5cqi, 1.5rem);
    text-align: center;
  }

  .product-teaser__title {
    font-family: var(--font-heading--family);
    /* Measured off the artwork: the name is 11.7% of the card's width there,
       which is why it reads as a nameplate rather than a caption. Sized in
       cqi so it stays that proportion on a phone as well as a laptop. */
    font-size: clamp(1.5rem, 11.5cqi, 3rem);
    line-height: 1.05;
    margin: 0;
    color: var(--pt-accent);
    text-wrap: balance;
  }

  /* Hollow, like the packaging artwork. Same font - Noto Serif Display Extra
     Condensed, already loaded in layout/theme.liquid - with the fill dropped
     and the contour stroked instead, the way the nav thickens on hover.

     The stroke is centred on the outline, so it eats into the stem rather
     than growing the word: the metrics stay the filled font's and nothing
     reflows. 0.038em is the artwork's ratio, and em keeps it true at every
     size. Guarded, because without text-stroke the transparent fill would
     leave the title invisible rather than merely solid. */
  @supports (-webkit-text-stroke: 1px currentColor) {
    .product-teaser__title {
      color: transparent;
      -webkit-text-stroke: 0.038em var(--pt-accent);
    }
  }

  /* Windows high-contrast throws the stroke away but keeps the fill, so the
     fill has to come back. */
  @media (forced-colors: active) {
    .product-teaser__title {
      color: CanvasText;
      -webkit-text-stroke-width: 0;
    }
  }

  .product-teaser__media {
    aspect-ratio: var(--pt-ratio, auto);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .product-teaser__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-teaser__line {
    margin: 0;
    /* Keeps the description hugging the photo while the gap it would have
       taken goes under it, above the bar. */
    margin-block-end: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--pt-ink);
  }

  .product-teaser__cta-form {
    margin: 0;
    display: flex;
  }

  /* The solid bar, flush to the card's three lower edges. */
  .product-teaser__cta {
    display: block;
    width: 100%;
    border: 0;
    padding: 0.875rem 1rem;
    background: var(--pt-accent);
    color: #fff;
    font-family: var(--font-body--family);
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .product-teaser__cta:hover,
  .product-teaser__cta:focus-visible {
    background: var(--pt-accent-deep);
    color: #fff;
  }

  /* The quieter form, for a card that shouldn't shout. */
  .product-teaser__cta--link {
    background: transparent;
    color: var(--pt-accent);
    padding-block: 0 clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: 0.9375rem;
    font-weight: 500;
    text-underline-offset: 0.3em;
    text-decoration: underline;
  }

  .product-teaser__cta--link:hover,
  .product-teaser__cta--link:focus-visible {
    background: transparent;
    color: var(--pt-accent-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-teaser__card {
      transition: none;
    }

    .product-teaser__card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "4:3 matches the product photos and keeps both cards the same height.",
      "options": [
        { "value": "four-three", "label": "4:3" },
        { "value": "three-two", "label": "3:2" },
        { "value": "square", "label": "Square" },
        { "value": "adapt", "label": "Natural (no crop)" }
      ],
      "default": "four-three"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Call to action",
      "options": [
        { "value": "bar", "label": "Solid bar" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "bar"
    },
    { "type": "range", "id": "max_width", "label": "Row width", "min": 36, "max": 80, "step": 2, "unit": "rem", "default": 54 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Button label", "default": "add to cart" },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Set this and the button really adds to the cart. Leave it empty and it links to the collection below instead."
        },
        { "type": "url", "id": "link_url", "label": "Link", "info": "Used only while no product is chosen." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product teaser",
      "blocks": [
        { "type": "product", "settings": { "title": "Chai Masala + Tea", "link_label": "add to cart" } },
        { "type": "product", "settings": { "title": "Indian Filter Coffee", "link_label": "add to cart" } }
      ]
    }
  ]
}
{% endschema %}
