{% comment %}
  One beat of a story: a photograph big enough to be looked at, and the text
  beside it at a size you can read.

  It replaces media-with-content for the narrative pages. The difference that
  matters is proportion - the old section set its copy at 14px in a narrow
  column beside an image about a quarter of the screen, with a tiny tracked
  label above the heading. Here the picture takes half the page, the copy is
  set at 19px, and the label is gone.

  The grid lives on an inner wrapper because `.section` is the theme's own
  three column page grid and puts every direct child in the middle column.
{% endcomment %}

{%- liquid
  assign chapter_image = section.settings.image
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--page-width color-{{ section.settings.color_scheme }} story-chapter spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  <div class="story-chapter__inner story-chapter__inner--media-{{ section.settings.media_side }}">
    {%- if chapter_image != blank -%}
      <figure class="story-chapter__figure" data-kcc-rise>
        {{
          chapter_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 750px) 48vw, 92vw',
            widths: '500, 800, 1100, 1600',
            alt: section.settings.image_alt,
            class: 'story-chapter__image'
        }}
        {%- if section.settings.caption != blank -%}
          <figcaption class="story-chapter__caption">{{ section.settings.caption }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="story-chapter__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="story-chapter__heading" data-kcc-rise>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="story-chapter__body rte" data-kcc-rise>{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.attribution != blank -%}
        <p class="story-chapter__attribution" data-kcc-rise>{{ section.settings.attribution }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .story-chapter__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  .story-chapter__figure {
    margin: 0;
    order: 2;
  }

  .story-chapter__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .story-chapter__caption {
    margin: 0.875rem 0 0;
    font-size: var(--kcc-small);
    line-height: 1.5;
    opacity: 0.75;
    max-width: 30rem;
  }

  .story-chapter__heading {
    font-family: var(--font-heading--family);
    font-size: var(--kcc-h2);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }

  .story-chapter__body p {
    margin: 0 0 1rem;
    font-size: var(--kcc-body);
    line-height: 1.65;
    max-width: 34rem;
  }

  .story-chapter__body p:last-child {
    margin-block-end: 0;
  }

  .story-chapter__attribution {
    margin: 1.5rem 0 0;
    font-family: var(--font-heading--family);
    font-size: var(--kcc-body);
    opacity: 0.8;
  }

  @media screen and (min-width: 750px) {
    .story-chapter__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .story-chapter__inner--media-start .story-chapter__figure {
      order: 0;
    }

    .story-chapter__image {
      aspect-ratio: 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story chapter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "attribution", "label": "Attribution" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Photograph description" },
    { "type": "text", "id": "caption", "label": "Caption" },
    {
      "type": "select",
      "id": "media_side",
      "label": "Photograph on the",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "end", "label": "Right" }
      ],
      "default": "start"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Story chapter" }]
}
{% endschema %}
