{% comment %}
  Ingredient spotlight: a heading, one spice's illustration/benefits at a time,
  and a row of circular icon buttons that swap which spice is shown. Only the
  panel matching the clicked button is visible; no page reload/network request,
  it's a pure client-side show/hide keyed by block index.

  Button icons: Santosh's real artwork for all 9 spices lives in
  snippets/ingredient-icon-sprite.liquid, rendered once below as a hidden SVG
  sprite; ingredient-icon.liquid then points at a symbol by spice name. For a
  name with no matching drawing, or once a merchant uploads a custom "Button
  icon" image, this falls back to icon-or-image (the shared icon set / uploaded
  image), same pattern the theme already uses for the dietary-icon blocks
  elsewhere.

  Illustrations: pass an uploaded image via the block's "Illustration" setting.
  Falls back to a placeholder line-art SVG when empty.
{% endcomment %}

{% liquid
  assign first_block = section.blocks | first
%}

{%- comment -%}
  The spice-pattern watermark rides on the theme's own section-background
  element rather than on a pseudo-element of the content div. That element is
  already exactly viewport-wide and absolutely positioned, so the pattern gets
  its full-bleed for free; doing it with a 100vw pseudo-element instead added
  9px of horizontal overflow on mobile, because 100vw counts the scrollbar.

  The URL has to be handed to the CSS from here: {% stylesheet %} is static and
  never sees Liquid, so asset_url can't be written inside it.
{%- endcomment -%}
<div
  class="section-background color-{{ section.settings.color_scheme }} ingredient-spotlight__bg"
  style="--kcc-ingredient-pattern: url('{{ 'ingredient-pattern.svg' | asset_url }}');"
></div>
<div
  id="ingredient-spotlight-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} ingredient-spotlight spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  {%- render 'ingredient-icon-sprite', uid: section.id -%}
  <div class="ingredient-spotlight__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ingredient-spotlight__heading h2">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ingredient-spotlight__panels">
      {%- for block in section.blocks -%}
        {%- if block.type == 'spice' -%}
          <div
            class="ingredient-spotlight__panel{% if block == first_block %} is-active{% endif %}"
            data-spice-panel="{{ forloop.index0 }}"
            {% unless block == first_block %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="ingredient-spotlight__text">
              <h3 class="ingredient-spotlight__name">{{ block.settings.name }}</h3>
              {% if block.settings.benefit_1 != blank
                or block.settings.benefit_2 != blank
                or block.settings.benefit_3 != blank
              %}
                <ul class="ingredient-spotlight__benefits">
                  {% if block.settings.benefit_1 != blank %}
                    <li>{{ block.settings.benefit_1 }}</li>
                  {% endif %}
                  {% if block.settings.benefit_2 != blank %}
                    <li>{{ block.settings.benefit_2 }}</li>
                  {% endif %}
                  {% if block.settings.benefit_3 != blank %}
                    <li>{{ block.settings.benefit_3 }}</li>
                  {% endif %}
                </ul>
              {% endif %}
            </div>
            <div class="ingredient-spotlight__image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 60vw', widths: '300, 450, 600, 800'
                }}
              {%- else -%}
                {%- comment -%}
                  No merchant-uploaded illustration: use the big line-art from
                  the design icon set (see ingredient-illustration.liquid)
                  rather than Shopify's generic placeholder_svg_tag, which has
                  no relation to the spice.

                  This used to scale up the small button icon instead, which
                  capped the illustration at 300px because ginger and cinnamon
                  are embedded rasters in that artwork. The design set is vector
                  for all nine, so the ceiling is gone.
                {%- endcomment -%}
                {%- capture large_icon -%}
                  {%- render 'ingredient-illustration',
                    name: block.settings.name,
                    class_name: 'ingredient-spotlight__placeholder'
                  -%}
                {%- endcapture -%}
                {%- if large_icon != blank -%}
                  {{- large_icon -}}
                {%- else -%}
                  {%- render 'icon-or-image',
                    icon: block.settings.icon_fallback,
                    image_upload: block.settings.icon_image,
                    width: 240,
                    class_name: 'ingredient-spotlight__placeholder'
                  -%}
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ingredient-spotlight__buttons" role="tablist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'spice' -%}
          <button
            type="button"
            class="ingredient-spotlight__button{% if block == first_block %} is-active{% endif %}"
            data-spice-button="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if block == first_block %}true{% else %}false{% endif %}"
            aria-label="{{ block.settings.name }}"
            {{ block.shopify_attributes }}
          >
            {%- capture custom_icon -%}
              {%- if block.settings.icon_image == blank -%}
                {%- render 'ingredient-icon',
                  name: block.settings.name,
                  uid: section.id,
                  class_name: 'ingredient-spotlight__icon'
                -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if custom_icon != blank -%}
              {{- custom_icon -}}
            {%- else -%}
              {%- render 'icon-or-image',
                icon: block.settings.icon_fallback,
                image_upload: block.settings.icon_image,
                width: 28,
                class_name: 'ingredient-spotlight__icon'
              -%}
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="ingredient-spotlight__disclaimer">{{ section.settings.disclaimer }}</div>
    {% endif %}
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('ingredient-spotlight-{{ section.id }}');
    if (!root) return;

    const buttons = root.querySelectorAll('[data-spice-button]');
    const panels = root.querySelectorAll('[data-spice-panel]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = button.getAttribute('data-spice-button');

        buttons.forEach((otherButton) => {
          const isActive = otherButton === button;
          otherButton.classList.toggle('is-active', isActive);
          otherButton.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.getAttribute('data-spice-panel') === index;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });
      });
    });
  })();
</script>

{% stylesheet %}
  /* One ink colour for the whole section - the illustrations carry it baked in
     (an <img> can't inherit currentColor), so the name, benefits, disclaimer
     and the selected button are matched to the artwork rather than to the
     theme's near-black foreground. */
  .ingredient-spotlight {
    --kcc-ingredient-ink: #5c2f16;
  }

  /* The spice-pattern watermark, tiled across the full-bleed background
     element. Drawn on a pseudo-element so it layers over the colour scheme's
     own background rather than replacing it, and so it can carry its own
     opacity without fading the section's content. */
  .ingredient-spotlight__bg {
    position: relative;
    overflow: hidden;
  }

  .ingredient-spotlight__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--kcc-ingredient-pattern);
    background-repeat: repeat;
    background-size: 26rem auto;
    opacity: 0.07;
    pointer-events: none;
  }

  .ingredient-spotlight__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
  }

  /* The doubled class is deliberate: the theme sets heading colour via
     "h2, .h2.h2, ..." at (0,2,0), so a single class here loses and the
     heading stays near-black. */
  .ingredient-spotlight .ingredient-spotlight__heading.h2 {
    color: var(--color-primary, currentColor);
  }

  .ingredient-spotlight__heading {
    margin: 0;
    text-align: center;
    /* Matches the intro section's ("Let's create connections...") heading
       font-size exactly, formula copied from layout/theme.liquid's
       [id$="__intro"] .text-block.h2 > * rules per Santosh's request that
       this heading render at the same size. Both ends of the clamp() are
       identical to that rule; kept as two separate declarations (mobile
       base + >=750px override) rather than one combined expression so a
       future change to the intro's numbers can be diffed against this one
       line-for-line. */
    font-size: calc(var(--font-h2--size) * clamp(0.935, calc(0.935 + ((100vw - 320px) / 160px) * 0.11), 1.045));
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight__heading {
      font-size: calc(var(--font-h2--size) * clamp(1.045, calc(1.045 + ((100vw - 750px) / 550px) * 0.495), 1.54));
    }
  }

  .ingredient-spotlight__panels {
    width: 100%;
  }

  /* Name and benefits on the left, illustration on the right. The columns are
     weighted towards the illustration because it's the thing worth looking at;
     the text is three short lines and doesn't need half the width. */
  .ingredient-spotlight__panel {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 1.5rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight__panel {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      justify-items: stretch;
      gap: 2.5rem;
      min-height: 22rem;
    }
  }

  .ingredient-spotlight__panel[hidden] {
    display: none;
  }

  .ingredient-spotlight__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ingredient-spotlight__name {
    margin: 0;
    text-align: center;
    color: var(--kcc-ingredient-ink);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
  }

  .ingredient-spotlight__benefits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
    color: var(--kcc-ingredient-ink);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight__text,
    .ingredient-spotlight__benefits {
      align-items: flex-start;
      text-align: start;
    }

    .ingredient-spotlight__name {
      text-align: start;
    }
  }

  .ingredient-spotlight__image {
    flex: 0 0 auto;
    width: 100%;
    margin-inline: auto;
  }

  .ingredient-spotlight__image img,
  .ingredient-spotlight__image svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* The design-set illustrations are vector at every spice, so this is free to
     be as large as the column allows - the old 300px cap existed only because
     ginger and cinnamon were rasters in the button artwork. Each file is
     cropped to its own art bounds and their aspect ratios differ, so height is
     capped too, otherwise a wide one (carom, 1.62:1) and a square one
     (cinnamon, 1:1) would set very different panel heights and the icon row
     below would jump as you clicked between them. */
  .ingredient-spotlight__placeholder {
    width: 100%;
    max-width: 34rem;
    max-height: 20rem;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ingredient-spotlight__placeholder {
      max-width: 20rem;
      max-height: 14rem;
    }
  }

  .ingredient-spotlight__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .ingredient-spotlight__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 1px solid var(--color-primary, currentColor);
    border-radius: 50%;
    background: none;
    color: var(--color-primary, currentColor);
    cursor: pointer;
    /* width/height (not transform: scale) so growing on hover actually
       reflows the flex row and pushes neighboring buttons apart, per
       Santosh's request, rather than just visually overlapping them. */
    transition: width 0.15s ease, height 0.15s ease, border-width 0.15s ease;
  }

  .ingredient-spotlight__button:hover {
    width: 4.5rem;
    height: 4.5rem;
    border-width: 1.5px;
  }

  /* Selected: the ring and the drawing both go to the dark ink, so the active
     spice reads as the same colour as the big illustration it's showing while
     the other eight stay in the lighter terracotta. */
  .ingredient-spotlight__button.is-active {
    border-width: 2px;
    border-color: var(--kcc-ingredient-ink);
    color: var(--kcc-ingredient-ink);
  }

  .ingredient-spotlight__icon {
    /* Fill the button. Each icon's viewBox is its own circle from the source
       artwork, so sizing the svg to the button lines the drawing up with the
       CSS border ring exactly as it's drawn - the art covers ~90-100% of the
       circle there. Sizing the icon well inside the button (this was 2.25rem
       in a 4rem circle) left far more empty space than the artwork has, and
       shrank the fine line work to where it reads as a squiggle.

       Percentages, so this grows with the button on hover for free. */
    width: 100%;
    height: 100%;
    color: currentColor;
    /* Tea leaf and star anise are drawn slightly larger than their ring in the
       source and spill past it on purpose; don't clip that off. */
    overflow: visible;
  }

  /* Kept to the same measure as the rest of the section and in the section's
     ink rather than grey - it's a legal line, but the grandma line underneath
     it is doing brand work and shouldn't look like small print. */
  .ingredient-spotlight__disclaimer {
    align-self: stretch;
    max-width: 52rem;
    margin-block-start: 1.5rem;
    color: var(--kcc-ingredient-ink);
    font-size: 0.9375rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .ingredient-spotlight__disclaimer p {
    margin: 0 0 0.9rem;
  }

  .ingredient-spotlight__disclaimer p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient spotlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple, aromatic ingredients"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, cure, treat, or prevent any disease.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "spice",
      "name": "Spice",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Spice"
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Illustration"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Button icon (custom image)"
        },
        {
          "type": "select",
          "id": "icon_fallback",
          "label": "Fallback icon",
          "info": "Used until a custom button icon is uploaded above.",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "plant", "label": "Plant" },
            { "value": "pepper", "label": "Pepper" },
            { "value": "carrot", "label": "Carrot" },
            { "value": "fire", "label": "Fire" },
            { "value": "dairy", "label": "Dairy" },
            { "value": "star", "label": "Star" },
            { "value": "snowflake", "label": "Snowflake" },
            { "value": "recycle", "label": "Recycle" }
          ],
          "default": "leaf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient spotlight",
      "blocks": [
        { "type": "spice", "settings": { "name": "Cardamom", "benefit_1": "adds warmth", "benefit_2": "aids digestion", "benefit_3": "rich in antioxidants", "icon_fallback": "leaf" } },
        { "type": "spice", "settings": { "name": "Cinnamon", "benefit_1": "balances blood sugar", "benefit_2": "anti-inflammatory", "benefit_3": "adds natural sweetness", "icon_fallback": "fire" } },
        { "type": "spice", "settings": { "name": "Cloves", "benefit_1": "natural antiseptic", "benefit_2": "eases nausea", "benefit_3": "boosts immunity", "icon_fallback": "star" } },
        { "type": "spice", "settings": { "name": "Black pepper", "benefit_1": "boosts nutrient absorption", "benefit_2": "aids digestion", "benefit_3": "adds gentle heat", "icon_fallback": "pepper" } },
        { "type": "spice", "settings": { "name": "Fennel", "benefit_1": "soothes the stomach", "benefit_2": "freshens breath", "benefit_3": "rich in fiber", "icon_fallback": "plant" } },
        { "type": "spice", "settings": { "name": "Star anise", "benefit_1": "supports digestion", "benefit_2": "natural expectorant", "benefit_3": "adds licorice warmth", "icon_fallback": "snowflake" } },
        { "type": "spice", "settings": { "name": "Ginger", "benefit_1": "aids digestion", "benefit_2": "reduces inflammation", "benefit_3": "used in Ayurvedic medicine for 5,000+ years", "icon_fallback": "carrot" } },
        { "type": "spice", "settings": { "name": "Coffee bean", "benefit_1": "natural energy boost", "benefit_2": "rich in antioxidants", "benefit_3": "sourced from small farms", "icon_fallback": "recycle" } },
        { "type": "spice", "settings": { "name": "Tea leaf", "benefit_1": "full of antioxidants", "benefit_2": "supports focus", "benefit_3": "hand-picked & sun-dried", "icon_fallback": "dairy" } }
      ]
    }
  ]
}
{% endschema %}
