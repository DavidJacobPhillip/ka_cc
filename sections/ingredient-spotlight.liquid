{% comment %}
  Ingredient spotlight: a heading, one spice's illustration/benefits at a time,
  and a row of circular icon buttons that swap which spice is shown. Only the
  panel matching the clicked button is visible; no page reload/network request,
  it's a pure client-side show/hide keyed by block index.

  Button icons: Santosh's real artwork for all 9 spices lives in
  snippets/ingredient-icon-sprite.liquid, rendered once below as a hidden SVG
  sprite; ingredient-icon.liquid then points at a symbol by spice name. For a
  name with no matching drawing, or once a merchant uploads a custom "Button
  icon" image, this falls back to icon-or-image (the shared icon set / uploaded
  image), same pattern the theme already uses for the dietary-icon blocks
  elsewhere.

  Illustrations: pass an uploaded image via the block's "Illustration" setting.
  Falls back to a placeholder line-art SVG when empty.
{% endcomment %}

{% liquid
  assign first_block = section.blocks | first
%}

{%- comment -%}
  The spice-field backdrop rides on the theme's own section-background element
  rather than on a pseudo-element of the content div. That element is already
  exactly viewport-wide and absolutely positioned, so the artwork gets its
  full-bleed for free; doing it with a 100vw pseudo-element instead added 9px
  of horizontal overflow on mobile, because 100vw counts the scrollbar.

  The art is Santosh's "KCC All" drawing - one scattered composition, not a
  tile - so it's sized to cover rather than repeated. ingredient-scatter.svg is
  that file flattened out of its Affinity export: every nested matrix baked
  into the point data and the contours simplified to the resolution a 9%-opacity
  watermark can actually show, which took it from 4.3MB to 567KB. It keeps one
  <g class="kcc-scatter__item"> per icon, each tagged with its own centre and
  radius, which is what the drift/collision script below moves.

  The URL has to be handed to the CSS from here: {% stylesheet %} is static and
  never sees Liquid, so asset_url can't be written inside it.
{%- endcomment -%}
<div
  id="ingredient-scatter-{{ section.id }}"
  class="section-background color-{{ section.settings.color_scheme }} ingredient-spotlight__bg"
  style="--kcc-ingredient-scatter: url('{{ 'ingredient-scatter.svg' | asset_url }}');"
  data-scatter-src="{{ 'ingredient-scatter.svg' | asset_url }}"
></div>
<div
  id="ingredient-spotlight-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} ingredient-spotlight spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  {%- render 'ingredient-icon-sprite', uid: section.id -%}
  <div class="ingredient-spotlight__inner">
    {% if section.settings.heading != blank %}
      <h2 class="ingredient-spotlight__heading h2">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ingredient-spotlight__panels">
      {%- for block in section.blocks -%}
        {%- if block.type == 'spice' -%}
          <div
            class="ingredient-spotlight__panel{% if block == first_block %} is-active{% endif %}"
            data-spice-panel="{{ forloop.index0 }}"
            {% unless block == first_block %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="ingredient-spotlight__text">
              <h3 class="ingredient-spotlight__name">{{ block.settings.name }}</h3>
              {% if block.settings.benefit_1 != blank
                or block.settings.benefit_2 != blank
                or block.settings.benefit_3 != blank
              %}
                <ul class="ingredient-spotlight__benefits">
                  {% if block.settings.benefit_1 != blank %}
                    <li>{{ block.settings.benefit_1 }}</li>
                  {% endif %}
                  {% if block.settings.benefit_2 != blank %}
                    <li>{{ block.settings.benefit_2 }}</li>
                  {% endif %}
                  {% if block.settings.benefit_3 != blank %}
                    <li>{{ block.settings.benefit_3 }}</li>
                  {% endif %}
                </ul>
              {% endif %}
            </div>
            <div class="ingredient-spotlight__image">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 60vw', widths: '300, 450, 600, 800'
                }}
              {%- else -%}
                {%- comment -%}
                  No merchant-uploaded illustration: use the big line-art from
                  the design icon set (see ingredient-illustration.liquid)
                  rather than Shopify's generic placeholder_svg_tag, which has
                  no relation to the spice.

                  This used to scale up the small button icon instead, which
                  capped the illustration at 300px because ginger and cinnamon
                  are embedded rasters in that artwork. The design set is vector
                  for all nine, so the ceiling is gone.
                {%- endcomment -%}
                {%- capture large_icon -%}
                  {%- render 'ingredient-illustration',
                    name: block.settings.name,
                    class_name: 'ingredient-spotlight__placeholder'
                  -%}
                {%- endcapture -%}
                {%- if large_icon != blank -%}
                  {{- large_icon -}}
                {%- else -%}
                  {%- render 'icon-or-image',
                    icon: block.settings.icon_fallback,
                    image_upload: block.settings.icon_image,
                    width: 240,
                    class_name: 'ingredient-spotlight__placeholder'
                  -%}
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="ingredient-spotlight__buttons" role="tablist">
      {%- for block in section.blocks -%}
        {%- if block.type == 'spice' -%}
          <button
            type="button"
            class="ingredient-spotlight__button{% if block == first_block %} is-active{% endif %}"
            data-spice-button="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if block == first_block %}true{% else %}false{% endif %}"
            aria-label="{{ block.settings.name }}"
            {{ block.shopify_attributes }}
          >
            {%- capture custom_icon -%}
              {%- if block.settings.icon_image == blank -%}
                {%- render 'ingredient-icon',
                  name: block.settings.name,
                  uid: section.id,
                  class_name: 'ingredient-spotlight__icon'
                -%}
              {%- endif -%}
            {%- endcapture -%}
            {%- if custom_icon != blank -%}
              {{- custom_icon -}}
            {%- else -%}
              {%- render 'icon-or-image',
                icon: block.settings.icon_fallback,
                image_upload: block.settings.icon_image,
                width: 28,
                class_name: 'ingredient-spotlight__icon'
              -%}
            {%- endif -%}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="ingredient-spotlight__disclaimer">{{ section.settings.disclaimer }}</div>
    {% endif %}
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('ingredient-spotlight-{{ section.id }}');
    if (!root) return;

    const buttons = root.querySelectorAll('[data-spice-button]');
    const panels = root.querySelectorAll('[data-spice-panel]');

    /*
      Draw-on animation.

      The illustrations ship as <img>, which CSS can't reach inside, so the
      chosen spice's SVG is fetched and inlined on click. asset_url gives a
      same-origin path, so there's no CORS involved, and each file is cached
      after its first fetch.

      What's animated is a clip wipe per path, running along that path's own
      long axis, staggered in document order - which is the order the artist
      drew them, so the outline appears before the interior detail.

      It isn't a true stroke-dashoffset draw, and can't be: these drawings are
      expanded outlines, not strokes (every "line" is a closed filled shape
      with round-cap arcs at each end and no stroke attribute anywhere), so
      there's no stroke for a dash to travel along.

      Progressive enhancement throughout - the <img> is what renders on load
      and stays put if the fetch fails, if there's no JS, or if the visitor
      asks for reduced motion.
    */
    const svgCache = new Map();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const drawPanel = async (panel) => {
      if (reduceMotion.matches) return;
      const frame = panel.querySelector('.ingredient-spotlight__image');
      const img = frame && frame.querySelector('.ingredient-spotlight__placeholder');
      if (!frame || !img) return;

      const src = img.getAttribute('src');
      let markup = svgCache.get(src);
      if (!markup) {
        try {
          const res = await fetch(src);
          if (!res.ok) return;
          markup = await res.text();
        } catch {
          return;
        }
        svgCache.set(src, markup);
      }

      const previous = frame.querySelector('.ingredient-spotlight__drawing');
      if (previous) previous.remove();

      const holder = document.createElement('div');
      holder.innerHTML = markup;
      const svg = holder.querySelector('svg');
      if (!svg) return;

      svg.setAttribute('class', 'ingredient-spotlight__drawing');
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', img.getAttribute('alt') || '');
      frame.appendChild(svg);
      frame.classList.add('is-drawing');

      // getBBox needs the node in the document, hence after appendChild.
      const paths = Array.from(svg.querySelectorAll('path'));

      /*
        Cap how many things actually animate.

        clip-path isn't compositor-accelerated, so each animated element costs
        main-thread work every frame. Carom is 492 separate paths - a scatter
        of tiny seeds - and animating all of them individually measured a 50ms
        95th-percentile frame under 4x CPU throttling, i.e. visible jank, for
        detail nobody can see at this size. Above the cap, consecutive paths
        are wrapped in groups and the group is what wipes. Sparse drawings
        (cinnamon is 24 paths) are untouched and still draw line by line.
      */
      const MAX_TARGETS = 150;
      let targets = paths;
      if (paths.length > MAX_TARGETS) {
        const perGroup = Math.ceil(paths.length / MAX_TARGETS);
        const groups = [];
        let current = null;
        paths.forEach((path, i) => {
          // Start a new group every perGroup paths, and whenever the parent
          // changes - a <g> can only adopt siblings.
          if (!current || current.count >= perGroup || current.parent !== path.parentNode) {
            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            path.parentNode.insertBefore(g, path);
            current = { el: g, parent: g.parentNode, count: 0 };
            groups.push(g);
          }
          current.el.appendChild(path);
          current.count += 1;
        });
        targets = groups;
      }

      /*
        The stagger is derived from the target count rather than fixed, because
        the drawings vary enormously. At a flat 13ms cinnamon takes 0.7s and
        carom 6.8s, and carom would still be drawing itself long after you'd
        stopped caring. Spreading a fixed span instead keeps every spice at
        roughly a second, clamped so sparse ones don't crawl.
      */
      const step = Math.min(18, Math.max(3, 620 / Math.max(targets.length, 1)));
      svg.style.setProperty('--kcc-draw-step', step + 'ms');

      targets.forEach((target, i) => {
        const box = target.getBBox();
        target.setAttribute('data-kcc-draw', '');
        target.style.setProperty('--kcc-draw-i', i);
        target.style.setProperty(
          '--kcc-draw-from',
          box.width >= box.height ? 'inset(0 100% 0 0)' : 'inset(100% 0 0 0)'
        );
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = button.getAttribute('data-spice-button');

        buttons.forEach((otherButton) => {
          const isActive = otherButton === button;
          otherButton.classList.toggle('is-active', isActive);
          otherButton.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach((panel) => {
          const isActive = panel.getAttribute('data-spice-panel') === index;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
          if (isActive) drawPanel(panel);
        });
      });
    });
  })();
</script>

<script>
  (() => {
    /*
      The spice field parts around the pointer.

      Every icon in the backdrop art is its own <g class="kcc-scatter__item">,
      tagged by the build with the centre and radius of its own ink. Moving the
      cursor through the field nudges whatever it passes near out of the way;
      each icon springs back to where it was drawn once the cursor has gone.

      The field is at rest until the pointer touches it - the loop stops
      entirely when nothing is moving and a pointer move restarts it - so this
      costs nothing on a page nobody is interacting with.

      Two details are what stop it feeling like a cursor-shaped hole:
        - the push is measured against the segment the pointer travelled since
          the last frame, not its current position, so a fast flick still
          displaces everything it crossed instead of skipping over it;
        - a fraction of the push goes along the direction of travel rather than
          straight away from the cursor, so the field parts and trails behind
          the stroke rather than bulging outwards from a point.

      Icons still collide with each other, so a nudged icon hands some of the
      push on to its neighbours and the disturbance spreads a little past the
      cursor's own reach.

      Progressive enhancement: the CSS background-image is what renders on
      load and stays if the fetch fails, if there's no JS, or if the visitor
      asks for reduced motion. The inlined SVG carries the same viewBox and
      preserveAspectRatio="xMidYMid slice" as the CSS cover sizing, so it
      lands on the identical crop and the swap can't be seen.
    */
    const bg = document.getElementById('ingredient-scatter-{{ section.id }}');
    if (!bg) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMotion.matches) return;

    const src = bg.getAttribute('data-scatter-src');
    if (!src) return;

    /*
      All of this is in the artwork's own user units - the viewBox is
      2560x1440 - so the motion scales with the drawing instead of with the
      viewport, and an icon travels the same distance relative to its
      neighbours on a phone as on a 27" display.
    */
    const STEP = 1 / 60;
    /*
      Spring and damping make a lightly underdamped oscillator: a pushed icon
      swings out, comes back, overshoots a little and settles. SPRING sets how
      far a given push carries (excursion is roughly velocity / sqrt(SPRING)),
      DAMP how fast it dies out.

      Both are far stiffer than the version this replaces. That one was tuned
      for a field under constant random disturbance, where a four-second
      wallow never showed; driven by a cursor it read as broken, because the
      icons were still drifting home long after the pointer had gone. Measured
      settle is about 2.5s now, with one small overshoot.
    */
    const SPRING = 0.004;
    const DAMP = 0.943;
    const RESTITUTION = 0.92;
    const MAX_SPIN = 4.5;      // degrees
    const SPIN_SPRING = 0.012;
    const SPIN_DAMP = 0.95;
    const SLEEP_V = 0.004;
    const SLEEP_D = 0.3;
    // Leash, in artwork units, scaled to the icon's own size: a fennel seed
    // travelling as far as a cinnamon stick would be moving further than its
    // own width and read as flying rather than nudged.
    const LEASH_MIN = 12;
    const LEASH_MAX = 34;
    /*
      Pointer forces, also in artwork units. REACH is how far from the cursor
      an icon has to be before it ignores it - 200 units is about 110px on a
      desktop-width section. The push is deliberately small: at full speed,
      directly under the cursor, a mid-sized icon swings about 20 units, which
      is ~11px on screen. Anything more and the backdrop stops being a backdrop.
    */
    const REACH = 200;
    const SPEED_REF = 60;      // units/frame that counts as a brisk flick
    const PUSH_MIN = 0.26;     // a slow drag still parts the field
    const PUSH_SPEED = 1;      // ...and a fast one parts it properly
    const SWEEP = 0.45;        // share of the push that follows the stroke
    const SWEEP_SPIN = 0.05;

    let items = [];
    let pairs = [];
    let raf = 0;
    let last = 0;
    let carry = 0;
    let loaded = false;
    let visible = false;
    let svgEl = null;

    /*
      Pointer position in the artwork's own coordinates. getScreenCTM is what
      does the mapping, because it already accounts for the slice crop and the
      page's scroll offset - working it out from the element's rect would mean
      redoing that arithmetic and getting it wrong on one axis. It's cached and
      dropped on scroll/resize rather than read per event, since reading it
      forces layout.
    */
    const pointer = { x: 0, y: 0, prevX: 0, prevY: 0, fresh: false, seen: false };
    let ctm = null;
    const dropCTM = () => { ctm = null; };

    const toArt = (clientX, clientY) => {
      if (!svgEl) return null;
      if (!ctm) {
        const m = svgEl.getScreenCTM();
        if (!m) return null;
        ctm = m.inverse();
      }
      return new DOMPoint(clientX, clientY).matrixTransform(ctm);
    };

    /*
      Push everything near the segment the pointer covered since the last
      frame. Distance is to the segment, not to its end point: at 2000px/s the
      cursor can clear an icon's whole reach between two frames, and measuring
      against the end point alone would let it slip through untouched.
    */
    const sweep = () => {
      const ax = pointer.prevX;
      const ay = pointer.prevY;
      const dx = pointer.x - ax;
      const dy = pointer.y - ay;
      const seg = Math.hypot(dx, dy);
      // A jump this big is a scroll or a tab switch, not a stroke.
      if (seg > 700) return;
      const speed = Math.min(seg / SPEED_REF, 1);

      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        const px = it.cx + it.ox;
        const py = it.cy + it.oy;

        let t = 0;
        if (seg > 1e-3) {
          t = ((px - ax) * dx + (py - ay) * dy) / (seg * seg);
          t = t < 0 ? 0 : t > 1 ? 1 : t;
        }
        let nx = px - (ax + dx * t);
        let ny = py - (ay + dy * t);
        let d = Math.hypot(nx, ny);
        if (d > REACH) continue;
        if (d < 1e-3) {
          // Dead centre: pick a direction rather than dividing by zero.
          const a = Math.random() * Math.PI * 2;
          nx = Math.cos(a);
          ny = Math.sin(a);
          d = 1;
        }

        const falloff = 1 - d / REACH;
        const f = falloff * falloff * (PUSH_MIN + PUSH_SPEED * speed) * (it.leash / 24);
        it.vx += (nx / d) * f;
        it.vy += (ny / d) * f;

        if (seg > 1e-3) {
          it.vx += (dx / seg) * f * SWEEP;
          it.vy += (dy / seg) * f * SWEEP;
          // Which side of the stroke it sits on decides which way it turns.
          it.va += ((nx * dy - ny * dx) / (d * seg)) * f * SWEEP_SPIN;
        }
        it.asleep = false;
      }
    };

    const build = (svg) => {
      // What the pointer mapping measures against.
      svgEl = svg;
      const nodes = svg.querySelectorAll('.kcc-scatter__item');
      items = Array.from(nodes).map((el) => {
        const r = parseFloat(el.getAttribute('data-r')) || 40;
        /*
          Mass from the ink's footprint, so a cinnamon stick shrugs off a
          fennel seed instead of the two trading equal momentum. Clamped at
          both ends: raw r spans 17 to 554 here (the big ginger root's bbox
          swallows half a quadrant), and a literal r^2 would make that root
          immovable, which reads as a bug rather than as weight.
        */
        const m = Math.pow(Math.min(Math.max(r, 24), 200), 1.5);
        return {
          el,
          cx: parseFloat(el.getAttribute('data-cx')) || 0,
          cy: parseFloat(el.getAttribute('data-cy')) || 0,
          r,
          inv: 1 / m,
          leash: Math.min(Math.max(r * 0.5, LEASH_MIN), LEASH_MAX),
          ox: 0, oy: 0, vx: 0, vy: 0,
          ang: 0, va: 0,
          asleep: true,
          dirty: false,
        };
      });

      pairs = [];
      for (let i = 0; i < items.length; i++) {
        for (let j = i + 1; j < items.length; j++) {
          const a = items[i];
          const b = items[j];
          const d0 = Math.hypot(a.cx - b.cx, a.cy - b.cy);
          const contact = a.r + b.r;
          /*
            Clusters in the drawing deliberately overlap - the pile of coffee
            beans, the ginger root sitting over its neighbours. If the resting
            distance were just a.r + b.r those pairs would start inside each
            other and the solver would blow Santosh's composition apart on the
            first frame. So a pair's rest distance is capped at how far apart
            it was actually drawn: it only pushes back once the two are closer
            than the artist put them.
          */
          const rest = Math.min(contact, d0 * 0.9);
          // Only pairs that could ever touch, given how far each can drift.
          if (d0 < contact + a.leash + b.leash + 4) pairs.push({ a, b, rest });
        }
      }

      // Starts at rest. Nothing moves until a pointer crosses the field.
    };

    const collide = () => {
      for (let k = 0; k < pairs.length; k++) {
        const { a, b, rest } = pairs[k];
        if (a.asleep && b.asleep) continue;
        const dx = (b.cx + b.ox) - (a.cx + a.ox);
        const dy = (b.cy + b.oy) - (a.cy + a.oy);
        const d = Math.hypot(dx, dy);
        if (d >= rest || d < 1e-4) continue;

        const nx = dx / d;
        const ny = dy / d;
        const invSum = a.inv + b.inv;

        // Ease them apart instead of snapping - a hard positional correction
        // on overlapping art pops visibly at this scale.
        const push = (rest - d) * 0.12;
        a.ox -= nx * push * (a.inv / invSum);
        a.oy -= ny * push * (a.inv / invSum);
        b.ox += nx * push * (b.inv / invSum);
        b.oy += ny * push * (b.inv / invSum);

        const rvx = b.vx - a.vx;
        const rvy = b.vy - a.vy;
        const vn = rvx * nx + rvy * ny;
        if (vn < 0) {
          const imp = (-(1 + RESTITUTION) * vn) / invSum;
          a.vx -= nx * imp * a.inv;
          a.vy -= ny * imp * a.inv;
          b.vx += nx * imp * b.inv;
          b.vy += ny * imp * b.inv;
          // Glancing hits spin things; head-on ones don't.
          const vt = rvx * -ny + rvy * nx;
          a.va -= vt * 0.5 * a.inv * 220;
          b.va += vt * 0.5 * b.inv * 220;
        }
        a.asleep = false;
        b.asleep = false;
      }
    };

    const integrate = () => {
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        if (it.asleep) continue;

        it.vx = (it.vx - it.ox * SPRING) * DAMP;
        it.vy = (it.vy - it.oy * SPRING) * DAMP;
        it.ox += it.vx;
        it.oy += it.vy;

        const d = Math.hypot(it.ox, it.oy);
        if (d > it.leash) {
          // Bounce off its own leash, so a run of shoves in one direction
          // can't walk an icon out of the composition.
          const s = it.leash / d;
          it.ox *= s;
          it.oy *= s;
          const nx = it.ox / it.leash;
          const ny = it.oy / it.leash;
          const vn = it.vx * nx + it.vy * ny;
          if (vn > 0) {
            it.vx -= 1.6 * vn * nx;
            it.vy -= 1.6 * vn * ny;
          }
        }

        it.va = (it.va - it.ang * SPIN_SPRING) * SPIN_DAMP;
        it.ang += it.va;
        if (it.ang > MAX_SPIN) { it.ang = MAX_SPIN; it.va = 0; }
        if (it.ang < -MAX_SPIN) { it.ang = -MAX_SPIN; it.va = 0; }

        it.dirty = true;
        if (
          Math.abs(it.vx) < SLEEP_V && Math.abs(it.vy) < SLEEP_V &&
          Math.abs(it.va) < SLEEP_V && d < SLEEP_D && Math.abs(it.ang) < 0.08
        ) {
          // Settle exactly back onto the drawn position, so a field at rest
          // is pixel-identical to the static background it replaced.
          it.ox = it.oy = it.vx = it.vy = it.ang = it.va = 0;
          it.asleep = true;
        }
      }
    };

    const draw = () => {
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        if (!it.dirty) continue;
        it.dirty = false;
        if (it.asleep) {
          it.el.removeAttribute('transform');
        } else {
          it.el.setAttribute(
            'transform',
            'translate(' + it.ox.toFixed(2) + ',' + it.oy.toFixed(2) + ') rotate(' +
              it.ang.toFixed(2) + ',' + it.cx + ',' + it.cy + ')'
          );
        }
      }
    };

    const tick = (now) => {
      // A tab that was backgrounded comes back with a huge gap; don't
      // simulate it, just carry on from here.
      const dt = last ? Math.min((now - last) / 1000, 0.1) : STEP;
      last = now;

      if (pointer.fresh) {
        sweep();
        pointer.fresh = false;
        pointer.prevX = pointer.x;
        pointer.prevY = pointer.y;
      }

      carry = Math.min(carry + dt, 0.25);
      while (carry >= STEP) {
        collide();
        integrate();
        carry -= STEP;
      }
      draw();

      // Stop dead once the field has settled. The next pointer move starts it
      // again; until then this section costs nothing per frame.
      let awake = 0;
      for (let i = 0; i < items.length; i++) {
        if (!items[i].asleep) awake++;
      }
      if (awake) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = 0;
        last = 0;
        carry = 0;
      }
    };

    const wake = () => {
      if (raf || !visible || !items.length) return;
      last = 0;
      carry = 0;
      raf = requestAnimationFrame(tick);
    };

    const onPointerMove = (e) => {
      if (!visible || !items.length) return;
      const p = toArt(e.clientX, e.clientY);
      if (!p) return;
      pointer.x = p.x;
      pointer.y = p.y;
      // The first sample after arriving has no stroke behind it, so treat it
      // as a standing start rather than a sweep from wherever it was last.
      if (!pointer.seen) {
        pointer.prevX = p.x;
        pointer.prevY = p.y;
        pointer.seen = true;
      }
      pointer.fresh = true;
      wake();
    };

    const play = () => {
      visible = true;
      dropCTM();
      wake();
    };

    const pause = () => {
      visible = false;
      pointer.seen = false;
      if (!raf) return;
      cancelAnimationFrame(raf);
      raf = 0;
    };

    const load = async () => {
      if (loaded) return;
      loaded = true;
      let markup;
      try {
        const res = await fetch(src);
        if (!res.ok) return;
        markup = await res.text();
      } catch {
        return;
      }
      const holder = document.createElement('div');
      holder.innerHTML = markup;
      const svg = holder.querySelector('svg');
      if (!svg) return;
      svg.setAttribute('class', 'ingredient-spotlight__scatter');
      svg.setAttribute('aria-hidden', 'true');
      svg.setAttribute('focusable', 'false');
      bg.appendChild(svg);
      bg.classList.add('is-scattered');
      build(svg);
    };

    // Nothing is fetched or simulated until the section is near the viewport,
    // and it stops again once it's scrolled past.
    const io = new IntersectionObserver(
      (entries) => {
        // Not named `visible`: that's the module-level flag play()/pause()
        // own, and shadowing it here is a trap for the next edit.
        const onScreen = entries.some((e) => e.isIntersecting);
        if (onScreen) {
          load().then(() => {
            if (items.length) play();
          });
        } else {
          pause();
        }
      },
      { rootMargin: '200px 0px' }
    );
    io.observe(bg);

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    // Both move the artwork under the cursor without a pointer event firing,
    // which would leave the cached mapping pointing at the wrong place.
    window.addEventListener('scroll', dropCTM, { passive: true });
    window.addEventListener('resize', dropCTM, { passive: true });

    reduceMotion.addEventListener('change', (e) => {
      if (e.matches) {
        pause();
        items.forEach((it) => {
          it.ox = it.oy = it.vx = it.vy = it.ang = it.va = 0;
          it.asleep = true;
          it.el.removeAttribute('transform');
        });
      } else if (items.length) {
        visible = true;
      }
    });
  })();
</script>

{% stylesheet %}
  /* One ink colour for the whole section - the illustrations carry it baked in
     (an <img> can't inherit currentColor), so the name, benefits, disclaimer
     and the selected button are matched to the artwork rather than to the
     theme's near-black foreground. */
  .ingredient-spotlight {
    --kcc-ingredient-ink: #5c2f16;
    /* The locked tertiary from the brand palette (PROJECT_CONTEXT "Color -
       LOCKED"), not a sampled approximation. Green is already how this theme
       says "selected": settings_data.json uses the same value for
       selected_variant_text_color on the product pages. */
    --kcc-ingredient-selected: #2e6417;
  }

  /* The spice-field watermark across the full-bleed background element. Drawn
     on a pseudo-element so it layers over the colour scheme's own background
     rather than replacing it, and so it can carry its own opacity without
     fading the section's content.

     One composition scaled to cover, not a tile: no-repeat plus cover, which
     is the background-image equivalent of the preserveAspectRatio="xMidYMid
     slice" baked into the SVG - so the static layer here and the inlined
     animated copy below crop to the identical frame and the swap is
     invisible. */
  .ingredient-spotlight__bg {
    position: relative;
    overflow: hidden;
  }

  .ingredient-spotlight__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--kcc-ingredient-scatter);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    opacity: var(--kcc-scatter-opacity, 0.09);
    pointer-events: none;
  }

  /* Once the live copy is inlined, the static one underneath is redundant
     ink - two stacked at 9% would read as 17%. */
  .ingredient-spotlight__bg.is-scattered::after {
    display: none;
  }

  .ingredient-spotlight__scatter {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--kcc-scatter-opacity, 0.09);
    pointer-events: none;
  }

  .ingredient-spotlight__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
  }

  /* The doubled class is deliberate: the theme sets heading colour via
     "h2, .h2.h2, ..." at (0,2,0), so a single class here loses and the
     heading stays near-black. Weight needs the same specificity for the
     same reason.

     700 is a synthesised bold - NotoCondensed.woff ships at 400 only - but
     unlike the nav, where faux-bold's extra width shifted neighbouring items,
     this heading is centred and alone on its line, so nothing moves. Compared
     against -webkit-text-stroke at the same size and the real weight read
     cleaner. */
  .ingredient-spotlight .ingredient-spotlight__heading.h2 {
    color: var(--color-primary, currentColor);
    font-weight: 700;
    /* Font-size has to live here too, at this specificity. The theme's
       "h2, .h2.h2, ..." sets font-size at (0,2,0) and this element carries
       both .ingredient-spotlight__heading and .h2, so the plain single-class
       rule below never won - the heading rendered at a bare
       var(--font-h2--size) and every change to the formula did nothing. */
    font-size: calc(
      var(--font-h2--size) * var(--kcc-heading-scale) *
        clamp(0.935, calc(0.935 + ((100vw - 320px) / 160px) * 0.11), 1.045)
    );
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight .ingredient-spotlight__heading.h2 {
      font-size: calc(
        var(--font-h2--size) * var(--kcc-heading-scale) *
          clamp(1.045, calc(1.045 + ((100vw - 750px) / 550px) * 0.495), 1.54)
      );
    }
  }

  .ingredient-spotlight__heading {
    /* The size formula is the intro section's, copied from
       layout/theme.liquid's [id$="__intro"] .text-block.h2 > * rules, so the
       two headings stay in proportion as the viewport changes. It lives in
       the higher-specificity rule above; this is just the dial.

       1 is the formula's own result - which is a large jump from what the
       heading used to render at, because what it used to render at was the
       theme's plain var(--font-h2--size) with this formula losing the
       cascade entirely. Turn this down to shrink the heading without
       touching the curve. */
    --kcc-heading-scale: 1;

    margin: 0;
    text-align: center;
  }

  .ingredient-spotlight__panels {
    width: 100%;
  }

  /* Name and benefits on the left, illustration on the right. The columns are
     weighted towards the illustration because it's the thing worth looking at;
     the text is three short lines and doesn't need half the width. */
  .ingredient-spotlight__panel {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 1.5rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight__panel {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      justify-items: stretch;
      gap: 2.5rem;
      min-height: 22rem;
    }
  }

  .ingredient-spotlight__panel[hidden] {
    display: none;
  }

  .ingredient-spotlight__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .ingredient-spotlight__name {
    margin: 0;
    text-align: center;
    color: var(--kcc-ingredient-ink);
    font-size: clamp(2.25rem, 5.6vw, 3.75rem);
    line-height: 1.05;
  }

  .ingredient-spotlight__benefits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
    color: var(--kcc-ingredient-ink);
    font-size: 1.1875rem;
    line-height: 1.55;
  }

  @media screen and (min-width: 750px) {
    .ingredient-spotlight__text,
    .ingredient-spotlight__benefits {
      align-items: flex-start;
      text-align: start;
    }

    .ingredient-spotlight__name {
      text-align: start;
    }
  }

  .ingredient-spotlight__image {
    flex: 0 0 auto;
    width: 100%;
    margin-inline: auto;
  }

  .ingredient-spotlight__image img,
  .ingredient-spotlight__image svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* The design-set illustrations are vector at every spice, so this is free to
     be as large as the column allows - the old 300px cap existed only because
     ginger and cinnamon were rasters in the button artwork. Each file is
     cropped to its own art bounds and their aspect ratios differ, so height is
     capped too, otherwise a wide one (carom, 1.62:1) and a square one
     (cinnamon, 1:1) would set very different panel heights and the icon row
     below would jump as you clicked between them. */
  .ingredient-spotlight__placeholder {
    width: 100%;
    max-width: 34rem;
    max-height: 20rem;
    height: auto;
    object-fit: contain;
    margin-inline: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ingredient-spotlight__placeholder {
      max-width: 20rem;
      max-height: 14rem;
    }
  }

  /* The inlined copy of the illustration that the draw-on animation runs on.
     Sized identically to the <img> it replaces so swapping one for the other
     doesn't shift the panel. */
  .ingredient-spotlight__drawing {
    width: 100%;
    max-width: 34rem;
    max-height: 20rem;
    height: auto;
    margin-inline: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ingredient-spotlight__drawing {
      max-width: 20rem;
      max-height: 14rem;
    }
  }

  .ingredient-spotlight__image.is-drawing .ingredient-spotlight__placeholder {
    display: none;
  }

  /* Each line wipes in along its own long axis - the per-path direction and
     stagger index are set from JS, since they come from each path's bbox. */
  .ingredient-spotlight__drawing [data-kcc-draw] {
    clip-path: var(--kcc-draw-from, inset(0 100% 0 0));
    animation: kcc-draw-in 0.42s ease forwards;
    animation-delay: calc(var(--kcc-draw-i, 0) * var(--kcc-draw-step, 13ms));
  }

  @keyframes kcc-draw-in {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ingredient-spotlight__drawing [data-kcc-draw] {
      clip-path: none;
      animation: none;
    }
  }

  .ingredient-spotlight__buttons {
    /* Held in a custom property because the mobile rule below has to do
       arithmetic with the same gap to work out a button's width. */
    --kcc-ing-button-gap: 1.25rem;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--kcc-ing-button-gap);
  }

  .ingredient-spotlight__button {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: 1px solid var(--color-primary, currentColor);
    border-radius: 50%;
    background: none;
    color: var(--color-primary, currentColor);
    cursor: pointer;
    /* Hover grows the button with a transform, not with width/height.

       Animating the box was the earlier behaviour and it made the whole
       section flinch: a wider button reflowed the flex row, so its neighbours
       slid sideways, and a taller row pushed the disclaimer underneath it
       further down the page. A transform is painted rather than laid out, so
       the button grows and nothing else on the page moves. */
    transition: transform 0.18s ease, border-width 0.18s ease, border-color 0.18s ease;
  }

  .ingredient-spotlight__button:hover {
    transform: scale(1.09);
    border-width: 1.5px;
  }

  /* Keep the hover feedback, drop the travel. */
  @media (prefers-reduced-motion: reduce) {
    .ingredient-spotlight__button {
      transition: none;
    }
  }

  /* Nine buttons on a phone: pin the row to exactly five so they break 5 + 4,
     both rows centred, instead of filling the width and stranding the last
     two on a row of their own. The basis is a fifth of the row once its four
     gaps are taken out, so five fill a line exactly and a sixth can never
     join them - at any phone width, without a breakpoint per device. */
  @media screen and (max-width: 749px) {
    .ingredient-spotlight__buttons {
      /* Fluid, because the row is pinned to five: every pixel taken out of the
         gaps goes straight into the buttons. The marquee rail eats ~57px of a
         phone's width, so on a 320px screen a flat 0.75rem gap left 37px
         buttons - under the 44px a thumb needs. */
      --kcc-ing-button-gap: clamp(0.4rem, 2.6vw, 0.75rem);
      /* Five buttons at their desktop size; past this the row would stretch
         and the icons would grow with it. */
      max-width: 23rem;
      margin-inline: auto;
    }

    .ingredient-spotlight__button {
      flex: 0 0 calc((100% - 4 * var(--kcc-ing-button-gap)) / 5);
      width: auto;
      height: auto;
      aspect-ratio: 1;
    }
  }

  /* Selected: the ring and the drawing both go to the brand green while the
     other eight stay in terracotta.

     This used to be the dark ink, chosen to match the big illustration the
     button was showing. Matching it made the selected state a tonal shift -
     terracotta to brown - which is a weak thing to carry the only "you are
     here" in the row. Green is a different hue rather than a darker one, so
     the selected spice is legible at a glance, and it's the colour the rest
     of the theme already selects with. */
  .ingredient-spotlight__button.is-active {
    border-width: 2px;
    border-color: var(--kcc-ingredient-selected);
    color: var(--kcc-ingredient-selected);
  }

  .ingredient-spotlight__icon {
    /* Fill the button. Each icon's viewBox is its own circle from the source
       artwork, so sizing the svg to the button lines the drawing up with the
       CSS border ring exactly as it's drawn - the art covers ~90-100% of the
       circle there. Sizing the icon well inside the button (this was 2.25rem
       in a 4rem circle) left far more empty space than the artwork has, and
       shrank the fine line work to where it reads as a squiggle.

       Percentages, so this grows with the button on hover for free. */
    width: 100%;
    height: 100%;
    color: currentColor;
    /* Tea leaf and star anise are drawn slightly larger than their ring in the
       source and spill past it on purpose; don't clip that off. */
    overflow: visible;
  }

  /* Kept to the same measure as the rest of the section and in the section's
     ink rather than grey - it's a legal line, but the grandma line underneath
     it is doing brand work and shouldn't look like small print. */
  .ingredient-spotlight__disclaimer {
    /* The block is centred on the page but its text is ragged-right inside
       it: align-self does the first (stretch would pin the block to the
       content's left edge), text-align the second. Both paragraphs share the
       box, so they share a left edge too. */
    align-self: center;
    max-width: 52rem;
    margin-block-start: 1.5rem;
    color: var(--kcc-ingredient-ink);
    font-size: 1.0625rem;
    line-height: 1.65;
    text-align: left;
    opacity: 0.9;
  }

  .ingredient-spotlight__disclaimer p {
    margin: 0 0 0.9rem;
  }

  .ingredient-spotlight__disclaimer p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient spotlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Simple, aromatic ingredients"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, cure, treat, or prevent any disease.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "spice",
