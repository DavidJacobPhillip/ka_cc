{% comment %}
  "Yum in Action" - the homepage photo strip.

  Replaces a stack of generic group/image/text blocks that could only produce
  one row of identically-cropped squares. Photos here keep their own aspect
  ratio and are matched on height instead, so a square pour sits next to a
  wide market shot without either being cut to fit - the same justified-row
  idea the timeline uses.

  The grid is laid out in reading order across a fixed number of rows, and
  scrolls sideways when the photos are wider than the page. That's deliberate
  rather than a fallback: at full width the last column sits half-visible,
  which is what tells you there's more to drag.
{% endcomment %}

{%- liquid
  assign photos = section.blocks | where: 'type', 'photo'
  assign rows = section.settings.rows | plus: 0
  if rows < 1
    assign rows = 1
  endif
  # ceil(count / rows), since Liquid's divided_by truncates on integers.
  assign columns = photos.size | plus: rows | minus: 1 | divided_by: rows
  if columns < 1
    assign columns = 1
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="photo-gallery-{{ section.id }}"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} photo-gallery spacing-style"
  style="
    {%- render 'spacing-style', settings: section.settings %}
    --pg-image-height-max: {{ section.settings.image_height }}px;
  "
>
  <div class="photo-gallery__inner">
    {%- if section.settings.label != blank -%}
      <p class="photo-gallery__label">{{ section.settings.label }}</p>
    {%- endif -%}

    <div class="photo-gallery__scroller">
      <div class="photo-gallery__track">
        <div class="photo-gallery__rows">
        {%- comment -%}
          Split into fixed-size rows here rather than letting a grid do it.
          A grid would share column widths between the rows, which would
          stretch the narrower photo in each column; these rows are
          independent, so every photo keeps its own width at the shared
          height - which is what the mockup shows, its two rows not lining
          up with each other.
        {%- endcomment -%}
        {%- for row in (1..rows) -%}
          {%- assign start = forloop.index0 | times: columns -%}
          {%- assign row_photos = photos | slice: start, columns -%}
          {%- if row_photos.size > 0 -%}
            <ul class="photo-gallery__row list-unstyled" role="list">
              {%- for block in row_photos -%}
                <li
                  class="photo-gallery__item"
                  style="--pg-ratio: {{ block.settings.image.aspect_ratio | default: 1 }};"
                  {{ block.shopify_attributes }}
                >
                  <figure class="photo-gallery__figure">
                    {%- if block.settings.image != blank -%}
                      {%- comment -%}
                        Height is fixed by CSS and width follows the aspect
                        ratio, so the intrinsic width/height attributes are
                        what stop the row reflowing as each photo arrives.
                      {%- endcomment -%}
                      <img
                        class="photo-gallery__image"
                        src="{{ block.settings.image | image_url: width: 1200 }}"
                        srcset="
                          {{ block.settings.image | image_url: width: 400 }} 400w,
                          {{ block.settings.image | image_url: width: 700 }} 700w,
                          {{ block.settings.image | image_url: width: 1000 }} 1000w,
                          {{ block.settings.image | image_url: width: 1400 }} 1400w
                        "
                        sizes="(min-width: 750px) 34vw, 70vw"
                        alt="{{ block.settings.image.alt | escape }}"
                        width="{{ block.settings.image.width }}"
                        height="{{ block.settings.image.height }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      <div class="photo-gallery__placeholder">
                        {{ 'detailed-apparel-1' | placeholder_svg_tag: 'photo-gallery__placeholder-svg' }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.caption != blank -%}
                      <figcaption class="photo-gallery__caption">{{ block.settings.caption }}</figcaption>
                    {%- endif -%}
                  </figure>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('photo-gallery-{{ section.id }}');
    if (!root) return;
    const scroller = root.querySelector('.photo-gallery__scroller');
    const track = root.querySelector('.photo-gallery__track');
    const rows = track && track.firstElementChild;
    if (!scroller || !track || !rows) return;

    /*
      A continuous drift rather than a slideshow: the strip is a single
      native scroller, so dragging it, flicking it on a phone and
      two-finger scrolling all keep working for free. The scrollbar is
      hidden in CSS - the half-visible photo at the edge is the affordance,
      and the drift itself tells you it moves.

      Looping works by cloning the row block once and wrapping scrollLeft
      back by exactly one copy's width, so the seam never shows. Nothing
      is cloned when the photos already fit, since there'd be nothing to
      scroll to.
    */
    const SPEED = 32;                      // px per second

    /*
      The drift keeps its own sub-pixel position. Reading scrollLeft back
      rounds to whole pixels, so "scrollLeft += 0.5" each frame reads the
      rounded value, adds half a pixel and writes a number that rounds
      straight back down - the strip sticks after a pixel or two and never
      moves again. Measured exactly that before this was here.
    */
    let pos = 0;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let loopWidth = 0;
    let cloned = false;

    const gapOf = () => parseFloat(getComputedStyle(track).columnGap) || 0;

    const setupLoop = () => {
      if (cloned || scroller.scrollWidth <= scroller.clientWidth + 1) return;
      const copy = rows.cloneNode(true);
      copy.setAttribute('aria-hidden', 'true');
      // the clone is decorative; keep it out of the tab order
      copy.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
      track.appendChild(copy);
      cloned = true;
      measure();
    };

    const measure = () => {
      loopWidth = cloned ? rows.getBoundingClientRect().width + gapOf() : 0;
    };

    // --- manual dragging
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    scroller.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startScroll = scroller.scrollLeft;
      scroller.classList.add('is-dragging');
      try { scroller.setPointerCapture(e.pointerId); } catch {}
    });

    scroller.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      // Only take over once it's clearly a drag, so a plain tap on a phone
      // still scrolls the page vertically.
      if (moved > 4) {
        e.preventDefault();
        scroller.scrollLeft = startScroll - dx;
      }
    });

    const endDrag = (e) => {
      if (!dragging) return;
      dragging = false;
      scroller.classList.remove('is-dragging');
      try { scroller.releasePointerCapture(e.pointerId); } catch {}
    };
    scroller.addEventListener('pointerup', endDrag);
    scroller.addEventListener('pointercancel', endDrag);

    // --- the drift
    let focused = false;
    let visible = true;
    let last = 0;
    let frame = 0;

    /* Deliberately no pause on hover: the cursor often rests over a
       full-width strip without anyone meaning to stop it, and having it
       freeze underneath you reads as broken. Dragging still takes over, and
       keyboard focus still holds it still so it can't move under someone
       tabbing through. */
    scroller.addEventListener('focusin', () => { focused = true; });
    scroller.addEventListener('focusout', () => { focused = false; });

    const tick = (now) => {
      frame = requestAnimationFrame(tick);
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 0;
      last = now;
      if (dragging || focused || !visible || reduceMotion.matches) return;
      pos += SPEED * dt;
      if (loopWidth && pos >= loopWidth) pos -= loopWidth;
      scroller.scrollLeft = pos;
    };

    // Wrapping also has to happen while a person scrolls or drags, not just
    // while the drift runs, or they hit a hard end.
    scroller.addEventListener('scroll', () => {
      // Anything that didn't come from the drift - a drag, a flick, a
      // trackpad, a keyboard - resyncs the accumulator, and wraps so a
      // person scrolling never reaches a hard end.
      if (Math.abs(scroller.scrollLeft - pos) < 2) return;
      pos = scroller.scrollLeft;
      if (!loopWidth) return;
      if (pos >= loopWidth) { pos -= loopWidth; scroller.scrollLeft = pos; }
      else if (pos <= 0) { pos += loopWidth; scroller.scrollLeft = pos; }
    }, { passive: true });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { visible = entries[0].isIntersecting; })
        .observe(root);
    }

    /*
      Hold the drift until the photos are actually on screen. They're lazy
      and far down the page, so without this the strip starts sliding the
      moment you reach it and the first thing you see is empty frames
      drifting past - measured taking several seconds on a cold load. The
      race means a slow or broken image delays this by at most 4s rather
      than stopping it.
    */
    const photosReady = () => {
      /* Only the photos near the left edge. The rest are lazy and sitting
         off to the right, so they won't load until they're scrolled to -
         waiting on those would hit the timeout every single time. */
      const base = rows.getBoundingClientRect().left;
      const reach = scroller.clientWidth * 1.5;
      const imgs = [...rows.querySelectorAll('img')]
        .filter((img) => img.getBoundingClientRect().left - base < reach);
      const pending = imgs.filter((img) => !img.complete || !img.naturalWidth);
      if (!pending.length) return Promise.resolve();
      return Promise.race([
        Promise.all(pending.map((img) => new Promise((done) => {
          img.addEventListener('load', done, { once: true });
          img.addEventListener('error', done, { once: true });
        }))),
        new Promise((done) => setTimeout(done, 4000)),
      ]);
    };

    const start = () => {
      setupLoop();
      photosReady().then(() => {
        measure();
        cancelAnimationFrame(frame);
        last = 0;
        pos = scroller.scrollLeft;
        frame = requestAnimationFrame(tick);
      });
    };

    /*
      Deliberately not gated on window.load: this page never reaches
      readyState "complete" within any reasonable time (measured - it sits
      at "interactive"), so waiting for load meant the drift never started.
      One rAF is enough, since layout only needs the photos' width/height
      attributes, which are on the markup. setupLoop is idempotent, so the
      later calls just cover a late relayout.
    */
    requestAnimationFrame(start);
    window.addEventListener('load', () => { setupLoop(); measure(); }, { once: true });
    window.addEventListener('resize', () => { setupLoop(); measure(); });
  })();
</script>

{% stylesheet %}
  .photo-gallery {
    /* Sampled from Santosh's mockup rather than taken from a colour scheme -
       it's a caption accent, not a surface, and no scheme carries it. */
    --pg-caption-color: #3c6224;
    /* The floor matters more than it looks: below about 13rem the photos get
       narrower than their own captions, and the caption starts setting the
       column width instead of the picture - which is exactly how "just make
       them smaller" goes wrong here.

       32vw, not 24: the middle term has to stay clear of the setting at
       ordinary desktop widths, or raising "Photo height" in the editor does
       nothing visible and reads as broken. At 1280px this leaves the setting
       in charge and the floor governs on a phone. */
    --pg-image-height: clamp(13rem, 32vw, var(--pg-image-height-max, 19rem));
    --pg-gap: clamp(1rem, 2.5vw, 2rem);
  }

  .photo-gallery__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 2rem);
    align-items: start;
    width: 100%;
    min-width: 0;
  }

  .photo-gallery__label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    margin: 0;
    font-family: var(--font-heading--family);
    /* Deliberately big - it reads as a title down the side of the strip
       rather than a caption, and at this size it stands roughly as tall as
       the photos beside it. */
    font-size: clamp(2.25rem, 6vw, 5rem);
    line-height: 1;
    color: var(--color-primary, currentColor);
    white-space: nowrap;
  }

  /* The sideways scroll. overflow-y stays visible so nothing clips the
     captions, and min-width: 0 is what actually lets a grid child shrink
     below its content and become scrollable at all. */
  .photo-gallery__scroller {
    overflow-x: auto;
    overflow-y: visible;
    min-width: 0;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    /* No scrollbar and no arrows: the drift plus the half-visible photo at
       the edge say it moves. Still a real scroller underneath, so flicking,
       trackpads and keyboards all work. */
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Dragging a photo would otherwise start a native image drag or select
       the captions. */
    user-select: none;
    -webkit-user-select: none;
  }

  .photo-gallery__scroller::-webkit-scrollbar {
    display: none;
  }

  .photo-gallery__track {
    display: flex;
    gap: var(--pg-gap);
    width: max-content;
  }

  .photo-gallery__image {
    -webkit-user-drag: none;
    user-drag: none;
  }

  .photo-gallery__rows {
    display: flex;
    flex-direction: column;
    gap: var(--pg-gap);
    width: max-content;
  }

  .photo-gallery__row {
    display: flex;
    gap: var(--pg-gap);
    align-items: flex-start;
    margin: 0;
    padding: 0;
  }

  /* flex: none so each item is exactly its photo's width at the shared
     height - neither stretched to fill the row nor shrunk to fit it. */
  /* Width comes from the photo's own aspect ratio at the shared height.
     Doing it here rather than letting the image size the item is what lets
     the caption be bounded by the picture - a ch cap can't know how wide
     any given photo is, so it either wrapped short captions or let long
     ones stretch the strip. */
  .photo-gallery__item {
    flex: none;
    width: calc(var(--pg-image-height) * var(--pg-ratio, 1));
    scroll-snap-align: start;
  }

  .photo-gallery__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    /* Not stretch: that would pull the <img> out to the item's width and,
       with object-fit: cover, crop it back to a shape it isn't. */
    align-items: center;
    width: 100%;
  }

  .photo-gallery__image,
  .photo-gallery__placeholder {
    height: var(--pg-image-height);
    width: 100%;
    display: block;
    /* The item is already the photo's exact ratio, so this crops nothing -
       it just guards against a rounding sliver. */
    object-fit: cover;
  }

  .photo-gallery__placeholder {
    aspect-ratio: 1;
    background: var(--color-border, #eee);
  }

  .photo-gallery__placeholder-svg {
    height: 100%;
    width: 100%;
  }

  .photo-gallery__caption {
    margin-block-start: 0.75rem;
    color: var(--pg-caption-color);
    font-size: clamp(0.8125rem, 1.1vw, 0.9375rem);
    line-height: 1.35;
    text-align: center;
    /* The item has an explicit width, so a caption wider than its photo
       overflows it rather than widening the strip - which means a caption
       can be readable AND stay on one line, overhanging its picture a
       little. 115% keeps that overhang well inside the gap between photos;
       past it a caption wraps instead of colliding with its neighbour. */
    flex: none;
    width: max-content;
    max-width: 115%;
  }

  .photo-gallery__caption p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .photo-gallery__inner {
      gap: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "label", "label": "Rotated label", "default": "Yum in Action" },
    {
      "type": "range",
      "id": "rows",
      "label": "Rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Photos fill left to right across this many rows, then scroll sideways."
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Photo height",
      "min": 160,
      "max": 420,
      "step": 10,
      "unit": "px",
      "default": 350,
      "info": "Desktop maximum. Photos keep their own shape and are matched on height."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "richtext", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "Photo gallery" }]
}
{% endschema %}
