{% comment %}
  The warm close: a wave into a field of brown, one photograph in the ring,
  a short statement and the one thing to do next.

  The band colour is painted on the inner element rather than on the theme's
  .section-background, because that element covers the whole section including
  the wave, and the wave needs the page behind it to show through above the
  curve. The wave's fill is the same setting, so the two can never disagree.
{% endcomment %}

{%- liquid
  assign band = section.settings.band_color
  assign note_image = section.settings.image
-%}

<div class="closing-note">
  {%- if section.settings.show_wave -%}
    {% render 'wave-divider', fill: band %}
  {%- endif -%}

  <div
    class="closing-note__band color-{{ section.settings.color_scheme }} spacing-style"
    style="background: {{ band }}; --closing-band: {{ band }}; {%- render 'spacing-style', settings: section.settings %}"
  >
    <div class="closing-note__inner">
      {%- if note_image != blank -%}
        <div class="closing-note__ring" data-kcc-rise>
          {{
            note_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 750px) 28vw, 62vw',
              widths: '400, 600, 800, 1000',
              alt: section.settings.image_alt,
              class: 'closing-note__image'
          }}
        </div>
      {%- endif -%}

      <div class="closing-note__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="closing-note__heading" data-kcc-rise>{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="closing-note__body rte" data-kcc-rise>{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="closing-note__action" href="{{ section.settings.link }}" data-kcc-rise>
            {{- section.settings.link_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .closing-note__band {
    padding-inline: clamp(1.25rem, 5vw, 5rem);
  }

  .closing-note__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    max-width: 68rem;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .closing-note__ring {
    aspect-ratio: 1;
    width: min(62vw, 20rem);
    border-radius: 50%;
    overflow: hidden;
  }

  .closing-note__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .closing-note__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }

  .closing-note__body p {
    margin: 1rem 0 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    max-width: 34rem;
  }

  .closing-note__action {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block-start: 1.75rem;
    padding: 0.75rem 1.5rem;
    /* Cream on the band, with the band's own colour as the ink: the scheme's
       background is the band itself here, so a button taking it would be
       invisible, and terracotta on brown measures 2:1. */
    background: #f9ebe6;
    color: var(--closing-band, #754b2a);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .closing-note__action:hover {
    opacity: 0.88;
  }

  .closing-note__action:active {
    transform: translateY(1px);
  }

  @media screen and (min-width: 750px) {
    .closing-note__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
      justify-items: start;
      text-align: start;
    }

    .closing-note__ring {
      width: min(28vw, 24rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Closing note",
  "settings": [
    { "type": "checkbox", "id": "show_wave", "label": "Wave into the band", "default": true },
    { "type": "color", "id": "band_color", "label": "Band colour", "default": "#754B2A" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_alt", "label": "Photograph description" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "Closing note" }]
}
{% endschema %}
