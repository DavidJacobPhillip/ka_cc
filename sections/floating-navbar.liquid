{% comment %}
  Floating navbar: a pill-shaped nav, fixed to the top of the viewport, whose
  items reveal a dropdown panel on hover/click. Ported from a React +
  framer-motion component (Menu/MenuItem/ProductItem/HoveredLink) to plain
  Liquid + CSS + vanilla JS - there's no build system or npm dependency in
  this theme, so the spring-in panel animation is approximated with a CSS
  cubic-bezier overshoot curve rather than framer-motion's spring physics.

  Each "item" block is either a plain link (content type "Direct link") or a
  hover/click trigger whose panel shows up to 4 links or up to 4 real
  products (via the product picker), matching the two dropdown styles from
  the source component (HoveredLink list vs. ProductItem grid).
{% endcomment %}

<div
  id="floating-navbar-{{ section.id }}"
  class="floating-navbar-wrapper color-{{ section.settings.color_scheme }}"
>
  <nav class="floating-navbar" data-floating-navbar aria-label="{{ section.settings.heading | default: 'Quick links' }}">
    <ul class="floating-navbar__list" role="menubar">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- liquid
            assign has_dropdown = false
            assign panel_content = ''

            if block.settings.content_type == 'links'
              capture panel_content
                for i in (1..4)
                  assign label_key = 'link_' | append: i | append: '_label'
                  assign url_key = 'link_' | append: i | append: '_url'
                  assign link_label = block.settings[label_key]
                  assign link_url = block.settings[url_key]
                  if link_label != blank
                    echo '<a href="' | append: link_url | default: '#' | append: '" class="floating-navbar__hovered-link">' | append: link_label | append: '</a>'
                  endif
                endfor
              endcapture
              assign panel_content = panel_content | strip
              if panel_content != blank
                assign has_dropdown = true
              endif
            elsif block.settings.content_type == 'products'
              capture panel_content
                for i in (1..4)
                  assign product_key = 'product_' | append: i
                  assign product = block.settings[product_key]
                  if product != blank
                    echo '<a href="' | append: product.url | append: '" class="floating-navbar__product">'
                    if product.featured_image != blank
                      echo product.featured_image | image_url: width: 280 | image_tag: loading: 'lazy', width: 140, height: 70, sizes: '140px', widths: '140, 280', class: 'floating-navbar__product-image'
                    else
                      echo 'product-1' | placeholder_svg_tag: 'floating-navbar__product-image'
                    endif
                    echo '<span><span class="floating-navbar__product-title">' | append: product.title | append: '</span><span class="floating-navbar__product-description">' | append: product.description | strip_html | truncate: 80 | append: '</span></span>'
                    echo '</a>'
                  endif
                endfor
              endcapture
              assign panel_content = panel_content | strip
              if panel_content != blank
                assign has_dropdown = true
              endif
            endif
          -%}
          <li class="floating-navbar__item" role="none" {{ block.shopify_attributes }}>
            {%- if has_dropdown -%}
              <button
                type="button"
                class="floating-navbar__link floating-navbar__trigger button-unstyled"
                role="menuitem"
                aria-haspopup="true"
                aria-expanded="false"
                data-floating-navbar-trigger
                data-index="{{ forloop.index0 }}"
              >
                {{- block.settings.label -}}
              </button>
              <div class="floating-navbar__panel{% if block.settings.content_type == 'products' %} floating-navbar__panel--products{% endif %}" data-floating-navbar-panel="{{ forloop.index0 }}">
                <div class="floating-navbar__panel-inner">
                  {{ panel_content }}
                </div>
              </div>
            {%- else -%}
              <a href="{{ block.settings.link | default: '#' }}" class="floating-navbar__link" role="menuitem">
                {{- block.settings.label -}}
              </a>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
</div>

<script>
  (() => {
    const root = document.getElementById('floating-navbar-{{ section.id }}');
    if (!root) return;

    const nav = root.querySelector('[data-floating-navbar]');
    const triggers = root.querySelectorAll('[data-floating-navbar-trigger]');
    const panels = root.querySelectorAll('[data-floating-navbar-panel]');
    const canHover = window.matchMedia('(hover: hover)').matches;

    let closeTimeout;

    const closeAll = () => {
      triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      panels.forEach((panel) => {
        panel.classList.remove('is-open');
        panel.setAttribute('inert', '');
      });
    };

    const openPanel = (index) => {
      clearTimeout(closeTimeout);
      triggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', trigger.dataset.index === index ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        const isMatch = panel.getAttribute('data-floating-navbar-panel') === index;
        panel.classList.toggle('is-open', isMatch);
        panel.toggleAttribute('inert', !isMatch);
      });
    };

    const scheduleClose = () => {
      clearTimeout(closeTimeout);
      closeTimeout = setTimeout(closeAll, 120);
    };

    triggers.forEach((trigger) => {
      const index = trigger.dataset.index;

      // Keyboard users (tab focus) get the panel open the same way hover does.
      trigger.addEventListener('focus', () => openPanel(index));

      if (canHover) {
        trigger.addEventListener('pointerenter', () => openPanel(index));
      } else {
        // Touch devices have no hover: tapping toggles the panel instead.
        // Only bound here, otherwise a click on an already-hover-opened
        // panel would immediately close it again on desktop.
        trigger.addEventListener('click', () => {
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          if (isOpen) {
            closeAll();
          } else {
            openPanel(index);
          }
        });
      }
    });

    panels.forEach((panel) => {
      panel.setAttribute('inert', '');

      if (canHover) {
        panel.addEventListener('pointerenter', () => clearTimeout(closeTimeout));
        panel.addEventListener('pointerleave', scheduleClose);
      }
    });

    if (canHover && nav) {
      nav.addEventListener('pointerleave', scheduleClose);
    }

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target)) closeAll();
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });

    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget)) closeAll();
    });
  })();
</script>

{% stylesheet %}
  .floating-navbar-wrapper {
    position: fixed;
    /* Sits just below the real header (announcement bar + header rows),
       whatever height that currently is, rather than a fixed offset that
       would overlap it. --header-group-height is set globally on <body> by
       sections/header.liquid. */
    top: calc(var(--header-group-height, 0px) + 1rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--layer-sticky);
    width: max-content;
    max-width: calc(100vw - 2 * var(--page-margin, 24px));
  }

  .floating-navbar {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .floating-navbar__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .floating-navbar__item {
    position: relative;
  }

  .floating-navbar__link {
    display: inline-flex;
    color: var(--color-foreground);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .floating-navbar__link:hover {
    opacity: var(--opacity-subdued-text, 0.7);
  }

  /* Positioned/animated like the source component's dropdown: centered under
     the trigger, popping in with a slight overshoot to approximate
     framer-motion's spring easing without a JS animation library. */
  .floating-navbar__panel {
    position: absolute;
    top: calc(100% + 1.2rem);
    left: 50%;
    transform: translate(-50%, 0.625rem) scale(0.9);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0s linear 0.2s;
  }

  .floating-navbar__panel.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), visibility 0s;
  }

  .floating-navbar__panel-inner {
    width: max-content;
    max-width: 90vw;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
  }

  .floating-navbar__hovered-link {
    display: block;
    color: var(--color-foreground);
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .floating-navbar__hovered-link:hover {
    opacity: 1;
  }

  .floating-navbar__panel-inner:has(.floating-navbar__hovered-link) {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .floating-navbar__panel--products .floating-navbar__panel-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .floating-navbar__product {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--color-foreground);
  }

  .floating-navbar__product-image {
    flex-shrink: 0;
    width: 140px;
    height: 70px;
    border-radius: 0.375rem;
    object-fit: cover;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  .floating-navbar__product-title {
    display: block;
    font-weight: bold;
    margin-block-end: 0.25rem;
  }

  .floating-navbar__product-description {
    display: block;
    max-width: 10rem;
    font-size: 0.875rem;
    opacity: 0.7;
  }

  @media screen and (max-width: 749px) {
    .floating-navbar {
      gap: 1rem;
      padding: 0.75rem 1.25rem;
    }

    .floating-navbar__list {
      gap: 1rem;
    }

    .floating-navbar__panel--products .floating-navbar__panel-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Floating navbar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible label",
      "info": "Not visible on the page, used for screen readers.",
      "default": "Quick links"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Menu item"
        },
        {
          "type": "select",
          "id": "content_type",
          "label": "Dropdown content",
          "options": [
            { "value": "direct", "label": "None (direct link)" },
            { "value": "links", "label": "Links" },
            { "value": "products", "label": "Products" }
          ],
          "default": "direct"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used when dropdown content is set to \"None\".",
          "visible_if": "{{ block.settings.content_type == 'direct' }}"
        },
        {
