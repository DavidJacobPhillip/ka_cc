{% comment %}
  A page's opening: eyebrow, heading, standfirst, optional button.

  The content pages were each opening differently - some with a media-with-
  content block, some with a bare h1 - so they didn't read as the same site.
  This gives them one consistent entrance.

  Centred by default because these pages open on text alone with no image to
  balance against.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} page-header page-header--{{ section.settings.alignment }} spacing-style"
  style="{%- render 'spacing-style', settings: section.settings %}"
>
  {%- if section.settings.eyebrow != blank -%}
    <p class="page-header__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h1 class="page-header__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.body != blank -%}
    <div class="page-header__body rte">{{ section.settings.body }}</div>
  {%- endif -%}
  {%- if section.settings.link_label != blank -%}
    <a class="page-header__cta" href="{{ section.settings.link_url | default: '#' }}">
      {{- section.settings.link_label -}}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .page-header--center {
    text-align: center;
  }

  .page-header__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary, currentColor);
  }

  .page-header__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    margin: 0;
    text-wrap: balance;
  }

  .page-header__body {
    margin-block-start: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: 0.82;
    max-width: 58ch;
  }

  .page-header--center .page-header__body {
    margin-inline: auto;
  }

  .page-header__cta {
    display: inline-block;
    margin-block-start: 1.75rem;
    padding: 0.85rem 1.75rem;
    border-radius: 0.3rem;
    background: var(--color-primary, currentColor);
    color: #fff;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .page-header__cta:hover {
    opacity: 0.9;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "link_label", "label": "Button label" },
    { "type": "url", "id": "link_url", "label": "Button link" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "start", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
